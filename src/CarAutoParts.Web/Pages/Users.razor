@page "/users"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="Users & Roles" Subtitle="User CRUD + roles list">
    <button class="btn btn-cap btn-sm" @onclick="() => BeginEdit(null)">Add user</button>
</PageHeader>
<LoadingState Busy="@_busy" Error="@_error" />

@if (_users is not null)
{
    <div class="cap-card table-responsive mb-3">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Username</th><th>Display</th><th>Roles</th><th>Branches</th><th>Active</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var u in _users.Items)
            {
                <tr>
                    <td>@u.Username</td>
                    <td>@u.DisplayName</td>
                    <td>@string.Join(", ", u.Roles)</td>
                    <td>@(u.BranchIds.Count == 0 ? "All (admin)" : string.Join(", ", u.BranchIds.Select(BranchLabel)))</td>
                    <td>@(u.IsActive ? "Yes" : "No")</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => BeginEdit(u)">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(u.Id)">Del</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_users.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@if (_roles is not null)
{
    <div class="cap-card mb-3">
        <h5>Roles</h5>
        <ul>@foreach (var r in _roles) { <li><strong>@r.Name</strong> — @r.Description (@r.PermissionCodes.Count perms)</li> }</ul>
    </div>
}

@if (_editing)
{
    <div class="cap-card">
        <div class="row g-2">
            <div class="col-md-3"><input class="form-control" placeholder="Username" @bind="_form.Username" /></div>
            <div class="col-md-3"><input class="form-control" placeholder="Display name" @bind="_form.DisplayName" /></div>
            <div class="col-md-3"><input class="form-control" placeholder="Email" @bind="_form.Email" /></div>
            <div class="col-md-3"><input class="form-control" type="password" placeholder="Password" @bind="_form.Password" /></div>
            <div class="col-md-3">
                <select class="form-select" @bind="_templateRole" @bind:after="ApplyTemplate">
                    <option value="">Role template…</option>
                    @if (_roles is not null)
                    {
                        @foreach (var r in _roles)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3"><input class="form-control" placeholder="RoleIds csv" @bind="_roleIdsText" /></div>
            <div class="col-md-6">
                <label class="form-label">Branches (leave empty for admin = all)</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var b in _branches)
                    {
                        var id = b.Id;
                        <label class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@_selectedBranches.Contains(id)"
                                   @onchange="e => ToggleBranch(id, (bool)(e.Value ?? false))" />
                            <span class="form-check-label">@b.Code — @b.Name</span>
                        </label>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Default branch</label>
                <select class="form-select" @bind="_defaultBranchText">
                    <option value="">—</option>
                    @foreach (var b in _branches.Where(x => _selectedBranches.Contains(x.Id)))
                    {
                        <option value="@b.Id">@b.Code — @b.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-cap" @onclick="SaveAsync">Save</button>
            <button class="btn btn-outline-light" @onclick="() => _editing = false">Cancel</button>
        </div>
    </div>
}

@code {
    private PagedResult<UserDto>? _users;
    private List<RoleDto>? _roles;
    private List<BranchDto> _branches = [];
    private readonly HashSet<int> _selectedBranches = [];
    private bool _busy = true, _editing;
    private string? _error, _roleIdsText, _defaultBranchText;
    private string _templateRole = "";
    private int? _editId;
    private UserCreateDto _form = new() { IsActive = true };
    private int _page = 1;
    private int _pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        var roles = await Api.GetRolesAsync();
        _roles = roles.Data;
        await LoadBranchesAsync();
        _busy = false;
    }

    private async Task LoadUsersAsync()
    {
        _busy = true;
        var users = await Api.GetUsersPagedAsync(new QuerySpec { Page = _page, PageSize = _pageSize });
        _users = users.Data; _error = users.Error;
        _busy = false;
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadUsersAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadUsersAsync(); }

    private async Task ReloadAllAsync()
    {
        await LoadUsersAsync();
        var roles = await Api.GetRolesAsync();
        _roles = roles.Data;
        await LoadBranchesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        var companies = await Api.GetCompaniesAsync();
        var companyId = companies.Data?.FirstOrDefault()?.Id;
        if (companyId is null) return;
        var branches = await Api.GetBranchesAsync(companyId.Value);
        _branches = branches.Data ?? [];
    }

    private string BranchLabel(int id)
    {
        var b = _branches.FirstOrDefault(x => x.Id == id);
        return b is null ? id.ToString() : b.Code;
    }

    private void ToggleBranch(int id, bool on)
    {
        if (on) _selectedBranches.Add(id);
        else
        {
            _selectedBranches.Remove(id);
            if (_defaultBranchText == id.ToString()) _defaultBranchText = "";
        }
    }

    private void ApplyTemplate()
    {
        if (string.IsNullOrWhiteSpace(_templateRole)) return;
        _roleIdsText = _templateRole;
    }

    private void BeginEdit(UserDto? u)
    {
        _editing = true;
        _selectedBranches.Clear();
        _defaultBranchText = "";
        if (u is null)
        {
            _editId = null;
            _form = new() { IsActive = true };
            _roleIdsText = _roles?.FirstOrDefault()?.Id.ToString();
            return;
        }

        _editId = u.Id;
        _form = new UserCreateDto { Username = u.Username, DisplayName = u.DisplayName, Email = u.Email, IsActive = u.IsActive };
        _roleIdsText = string.Join(",", _roles?.Where(r => u.Roles.Contains(r.Name)).Select(r => r.Id) ?? []);
        foreach (var id in u.BranchIds) _selectedBranches.Add(id);
        _defaultBranchText = u.DefaultBranchId?.ToString() ?? "";
    }

    private async Task SaveAsync()
    {
        _form.RoleIds = (_roleIdsText ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => int.TryParse(x, out var id) ? id : 0).Where(x => x > 0).ToList();
        _form.BranchIds = _selectedBranches.ToList();
        _form.DefaultBranchId = int.TryParse(_defaultBranchText, out var def) ? def : null;

        if (_editId is null)
        {
            var (_, error, _) = await Api.CreateUserAsync(_form);
            if (error is not null) { Toast.ShowError(error); return; }
        }
        else
        {
            var (_, error, _) = await Api.UpdateUserAsync(_editId.Value, _form);
            if (error is not null) { Toast.ShowError(error); return; }
        }
        _editing = false;
        await ReloadAllAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var (ok, error, _) = await Api.DeleteUserAsync(id);
        if (!ok) Toast.ShowError(error ?? "Failed"); else await ReloadAllAsync();
    }
}
