@page "/rfq"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="Purchase RFQ" Subtitle="Request quotes → compare vendors → create/link PO" />
<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive mb-3">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Number</th><th>Status</th><th>RFQ date</th><th>Deadline</th><th>PO</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var r in _items.Items)
            {
                <tr>
                    <td class="mono">@r.RfqNumber</td>
                    <td>@StatusName(r.Status)</td>
                    <td>@r.RfqDate.ToLocalTime().ToString("d")</td>
                    <td>@(r.ResponseDeadline?.ToLocalTime().ToString("d") ?? "—")</td>
                    <td>@(r.PurchaseOrderNumber ?? "—")</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => ViewAsync(r.Id)">View</button>
                            @if (r.Status == 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SendAsync(r.Id)">Send</button>
                            }
                            @if (r.Status is 0 or 1 or 2)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => CancelAsync(r.Id)">Cancel</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_items.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

<div class="cap-card mb-3">
    <h5>New RFQ</h5>
    <div class="row g-2">
        <div class="col-md-3"><label class="form-label small mb-0">Response deadline</label><input type="date" class="form-control" @bind="_deadline" /></div>
        <div class="col-md-6"><label class="form-label small mb-0">Notes</label><input class="form-control" @bind="_create.Notes" /></div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-md-4">
            <label class="form-label small mb-0">Product</label>
            <select class="form-select" @bind="_newLine.ProductId">
                <option value="0">Select…</option>
                @foreach (var p in _products)
                {
                    <option value="@p.Id">@p.Name (@p.Sku)</option>
                }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label small mb-0">Qty</label><input type="number" class="form-control" @bind="_newLine.Quantity" /></div>
        <div class="col-md-2 mt-4"><button class="btn btn-outline-light w-100" @onclick="AddLine">Add line</button></div>
    </div>
    @if (_create.Lines.Count > 0)
    {
        <table class="table table-cap table-sm mt-2 mb-0">
            <thead><tr><th>Product</th><th>Qty</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in _create.Lines)
            {
                <tr>
                    <td>@ProductName(l.ProductId)</td>
                    <td>@l.Quantity</td>
                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(l)">Remove</button></td>
                </tr>
            }
            </tbody>
        </table>
    }
    <div class="mt-3"><button class="btn btn-cap" @onclick="CreateRfqAsync">Create RFQ</button></div>
</div>

@if (_selected is not null)
{
    <div class="cap-card mb-3">
        <h5>@_selected.RfqNumber — lines</h5>
        <table class="table table-cap table-sm mb-0">
            <thead><tr><th>Product</th><th>Qty</th><th>Notes</th></tr></thead>
            <tbody>
            @foreach (var l in _selected.Lines)
            {
                <tr><td>@(l.ProductName ?? l.ProductId.ToString())</td><td>@l.Quantity</td><td>@l.Notes</td></tr>
            }
            </tbody>
        </table>
    </div>

    <div class="cap-card mb-3">
        <h5>Add vendor quote</h5>
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label small mb-0">Supplier</label>
                <select class="form-select" @bind="_quote.SupplierId">
                    <option value="0">Select…</option>
                    @foreach (var s in _suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><label class="form-label small mb-0">Valid until</label><input type="date" class="form-control" @bind="_quoteValidUntil" /></div>
            <div class="col-md-6"><label class="form-label small mb-0">Notes</label><input class="form-control" @bind="_quote.Notes" /></div>
        </div>
        <table class="table table-cap table-sm mt-2 mb-0">
            <thead><tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Lead days</th></tr></thead>
            <tbody>
            @foreach (var ql in _quote.Lines)
            {
                <tr>
                    <td>@ProductName(ql.ProductId)</td>
                    <td><input type="number" class="form-control form-control-sm" @bind="ql.Quantity" /></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" @bind="ql.UnitPrice" /></td>
                    <td><input type="number" class="form-control form-control-sm" @bind="ql.LeadTimeDays" /></td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-2"><button class="btn btn-cap" @onclick="AddQuoteAsync">Submit quote</button></div>
    </div>

    @if (_selected.VendorQuotes.Count > 0)
    {
        <div class="cap-card">
            <h5>Compare vendor quotes</h5>
            <div class="table-responsive">
                <table class="table table-cap table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            @foreach (var q in _selected.VendorQuotes)
                            {
                                <th>@(q.SupplierName ?? q.SupplierId.ToString()) (@StatusName(q.Status, quote: true))</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in _selected.Lines)
                    {
                        <tr>
                            <td>@(l.ProductName ?? l.ProductId.ToString())</td>
                            @foreach (var q in _selected.VendorQuotes)
                            {
                                var ql = q.Lines.FirstOrDefault(x => x.ProductId == l.ProductId);
                                <td>@(ql is null ? "—" : $"{ql.UnitPrice:N2} ({ql.LeadTimeDays?.ToString() ?? "-"}d)")</td>
                            }
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td>Total</td>
                        @foreach (var q in _selected.VendorQuotes)
                        {
                            <td>@q.TotalAmount.ToString("N2")</td>
                        }
                    </tr>
                    <tr>
                        <td>Actions</td>
                        @foreach (var q in _selected.VendorQuotes)
                        {
                            <td>
                                <button class="btn btn-sm btn-outline-primary mb-1" @onclick="() => SelectQuoteAsync(q.Id)">Select</button>
                                <button class="btn btn-sm btn-cap" @onclick="() => CreatePoAsync(q.Id)">Create PO</button>
                            </td>
                        }
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private PagedResult<PurchaseRfqDto>? _items;
    private PurchaseRfqDto? _selected;
    private CreatePurchaseRfqRequest _create = new();
    private CreatePurchaseRfqLineRequest _newLine = new() { Quantity = 1 };
    private CreateVendorQuoteRequest _quote = new();
    private DateTime? _deadline;
    private DateTime? _quoteValidUntil;
    private bool _busy = true;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 10;
    private List<ProductListDto> _products = [];
    private List<SupplierDto> _suppliers = [];

    protected override async Task OnInitializedAsync()
    {
        var (prod, _, _) = await Api.GetProductsAsync(new QuerySpec { Page = 1, PageSize = 200 });
        _products = prod?.Items ?? [];
        var (sup, _, _) = await Api.GetSuppliersAsync(new QuerySpec { Page = 1, PageSize = 200 });
        _suppliers = sup?.Items ?? [];
        await LoadAsync();
    }

    private string ProductName(int id) => _products.FirstOrDefault(p => p.Id == id) is { } p ? $"{p.Name} ({p.Sku})" : id.ToString();

    private static string StatusName(int s, bool quote = false) => quote
        ? s switch { 0 => "Draft", 1 => "Received", 2 => "Selected", 3 => "Rejected", _ => s.ToString() }
        : s switch { 0 => "Draft", 1 => "Sent", 2 => "Quotes received", 3 => "Closed", 4 => "Cancelled", _ => s.ToString() };

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetRfqsAsync(new QuerySpec { Page = _page, PageSize = _pageSize });
        _items = data; _error = error; _busy = false;
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }

    private void AddLine()
    {
        if (_newLine.ProductId == 0 || _newLine.Quantity <= 0) { Toast.ShowError("Select product and quantity"); return; }
        _create.Lines.Add(new CreatePurchaseRfqLineRequest { ProductId = _newLine.ProductId, Quantity = _newLine.Quantity });
        _newLine = new CreatePurchaseRfqLineRequest { Quantity = 1 };
    }

    private void RemoveLine(CreatePurchaseRfqLineRequest line) => _create.Lines.Remove(line);

    private async Task CreateRfqAsync()
    {
        if (_create.Lines.Count == 0) { Toast.ShowError("Add at least one line"); return; }
        _create.ResponseDeadline = _deadline;
        var (data, error, _) = await Api.CreateRfqAsync(_create);
        if (error is not null) Toast.ShowError(error);
        else
        {
            Toast.ShowSuccess($"RFQ {data?.RfqNumber} created");
            _create = new();
            _deadline = null;
            await LoadAsync();
        }
    }

    private async Task ViewAsync(int id)
    {
        var (data, error, _) = await Api.GetRfqAsync(id);
        if (error is not null) { Toast.ShowError(error); return; }
        _selected = data;
        _quote = new CreateVendorQuoteRequest
        {
            Lines = _selected?.Lines.Select(l => new CreateVendorQuoteLineRequest { ProductId = l.ProductId, Quantity = l.Quantity }).ToList() ?? []
        };
    }

    private async Task SendAsync(int id)
    {
        var (_, error, _) = await Api.SendRfqAsync(id);
        if (error is not null) Toast.ShowError(error); else { Toast.ShowSuccess("RFQ sent"); await LoadAsync(); }
    }

    private async Task CancelAsync(int id)
    {
        var (_, error, _) = await Api.CancelRfqAsync(id);
        if (error is not null) Toast.ShowError(error); else { Toast.ShowSuccess("RFQ cancelled"); await LoadAsync(); }
    }

    private async Task AddQuoteAsync()
    {
        if (_selected is null) return;
        if (_quote.SupplierId == 0) { Toast.ShowError("Select a supplier"); return; }
        _quote.ValidUntil = _quoteValidUntil;
        var (_, error, _) = await Api.AddVendorQuoteAsync(_selected.Id, _quote);
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess("Quote added"); await ViewAsync(_selected.Id); await LoadAsync(); }
    }

    private async Task SelectQuoteAsync(int quoteId)
    {
        var (_, error, _) = await Api.SelectVendorQuoteAsync(quoteId);
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess("Quote selected"); if (_selected is not null) await ViewAsync(_selected.Id); }
    }

    private async Task CreatePoAsync(int quoteId)
    {
        var (po, error, _) = await Api.CreatePoFromQuoteAsync(quoteId);
        if (error is not null) Toast.ShowError(error);
        else
        {
            Toast.ShowSuccess($"PO {po?.OrderNumber} created");
            if (_selected is not null) await ViewAsync(_selected.Id);
            await LoadAsync();
        }
    }
}
