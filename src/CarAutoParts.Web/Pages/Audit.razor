@page "/audit"
@attribute [Authorize]
@inject CapApiService Api

<PageHeader Title="Audit Logs" Subtitle="Money and system change history" />

<div class="cap-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Search</label>
            <input class="form-control" @bind="_search" placeholder="Void, entity, user…" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Action</label>
            <select class="form-select" @bind="_action">
                <option value="">All</option>
                <option>Create</option>
                <option>Update</option>
                <option>Delete</option>
                <option>Post</option>
                <option>Void</option>
                <option>Approve</option>
                <option>Reject</option>
                <option>Login</option>
                <option>Logout</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Entity type</label>
            <input class="form-control" @bind="_entityType" placeholder="JournalEntry" />
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input type="date" class="form-control" @bind="_from" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input type="date" class="form-control" @bind="_to" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-cap w-100" @onclick="FilterAsync">Filter</button>
        </div>
    </div>
</div>

<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Changes</th></tr></thead>
            <tbody>
            @foreach (var a in _items.Items)
            {
                <tr>
                    <td>@a.Timestamp.ToLocalTime().ToString("g")</td>
                    <td>@a.UserName</td><td>@a.Action</td><td>@a.EntityType #@a.EntityId</td>
                    <td class="small text-truncate" style="max-width:28rem">@a.OldValues → @a.NewValues</td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_items.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@code {
    private PagedResult<AuditLogDto>? _items;
    private bool _busy = true;
    private string? _error;
    private string? _search;
    private string _action = "";
    private string? _entityType;
    private DateTime? _from;
    private DateTime? _to;
    private int _page = 1;
    private int _pageSize = 10;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        var search = _search;
        if (string.IsNullOrWhiteSpace(search) && !string.IsNullOrWhiteSpace(_action))
            search = _action;
        var (data, error, _) = await Api.GetAuditLogsAsync(
            new QuerySpec { Page = _page, PageSize = _pageSize, Search = search },
            _action, _entityType, _from, _to);
        _items = data; _error = error; _busy = false;
    }

    private async Task FilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }
}
