@page "/service/amc"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast
@inject PermissionService Perms

<PageHeader Title="AMC contracts" Subtitle="Annual maintenance coverage linked to service tickets">
    @if (_canManage)
    {
        <button type="button" class="btn btn-cap btn-sm" @onclick="StartNew">New contract</button>
    }
</PageHeader>

<LoadingState Busy="@_busy" Error="@_error" />

<div class="cap-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Customer</label>
            <select class="form-select" @bind="_filterCustomer">
                <option value="0">All</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select class="form-select" @bind="_filterStatus">
                <option value="">All</option>
                <option value="0">Draft</option>
                <option value="1">Active</option>
                <option value="2">Expired</option>
                <option value="3">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-outline-light w-100" @onclick="LoadAsync">Filter</button></div>
    </div>
</div>

@if (_edit is not null && _canManage)
{
    <div class="cap-card mb-3">
        <h6>@(_edit.Id is > 0 ? "Edit contract" : "New contract")</h6>
        <div class="row g-2">
            <div class="col-md-3"><label class="form-label">Number</label><input class="form-control" @bind="_edit.ContractNumber" /></div>
            <div class="col-md-3">
                <label class="form-label">Customer</label>
                <select class="form-select" @bind="_edit.CustomerId">
                    <option value="0">Select…</option>
                    @foreach (var c in _customers)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2"><label class="form-label">Start</label><input type="date" class="form-control" @bind="_edit.StartDate" /></div>
            <div class="col-md-2"><label class="form-label">End</label><input type="date" class="form-control" @bind="_edit.EndDate" /></div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select class="form-select" @bind="_edit.Status">
                    <option value="0">Draft</option>
                    <option value="1">Active</option>
                    <option value="2">Expired</option>
                    <option value="3">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2"><label class="form-label">Annual amount</label><input type="number" step="0.01" class="form-control" @bind="_edit.AnnualAmount" /></div>
            <div class="col-md-10"><label class="form-label">Coverage notes</label><input class="form-control" @bind="_edit.CoverageNotes" /></div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="button" class="btn btn-cap" @onclick="SaveAsync">Save</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => _edit = null">Cancel</button>
        </div>
    </div>
}

@if (_items is not null)
{
    <div class="cap-card table-responsive">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Number</th><th>Customer</th><th>Period</th><th>Status</th><th>Amount</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in _items)
            {
                <tr>
                    <td class="mono">@a.ContractNumber</td>
                    <td>@(a.CustomerName ?? a.CustomerId.ToString())</td>
                    <td>@a.StartDate.ToString("yyyy-MM-dd") – @a.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>@StatusLabel(a.Status)</td>
                    <td>@(a.AnnualAmount?.ToString("N2") ?? "—")</td>
                    <td>
                        @if (_canManage)
                        {
                            <button class="btn btn-sm btn-outline-light" @onclick="() => BeginEdit(a)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteAsync(a.Id)">Del</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _busy = true;
    private string? _error;
    private bool _canManage;
    private List<AmcContractDto>? _items;
    private List<CustomerDto> _customers = [];
    private AmcContractUpsertDto? _edit;
    private int _filterCustomer;
    private string _filterStatus = "";

    protected override async Task OnInitializedAsync()
    {
        _canManage = await Perms.HasAsync("service.manage");
        var (cust, _, _) = await Api.GetCustomersAsync(new QuerySpec { Page = 1, PageSize = 200 });
        _customers = cust?.Items ?? [];
        await LoadAsync();
    }

    private static string StatusLabel(int s) => s switch
    {
        0 => "Draft", 1 => "Active", 2 => "Expired", 3 => "Cancelled", _ => s.ToString()
    };

    private async Task LoadAsync()
    {
        _busy = true;
        int? status = int.TryParse(_filterStatus, out var st) ? st : null;
        var (data, error, _) = await Api.GetAmcContractsAsync(
            _filterCustomer > 0 ? _filterCustomer : null, status);
        _items = data; _error = error; _busy = false;
    }

    private void StartNew() => _edit = new AmcContractUpsertDto { Status = 1 };

    private void BeginEdit(AmcContractDto a) => _edit = new AmcContractUpsertDto
    {
        Id = a.Id, ContractNumber = a.ContractNumber, CustomerId = a.CustomerId,
        StartDate = a.StartDate, EndDate = a.EndDate, Status = a.Status,
        CoverageNotes = a.CoverageNotes, AnnualAmount = a.AnnualAmount, ProductId = a.ProductId
    };

    private async Task SaveAsync()
    {
        if (_edit is null) return;
        var (data, error, _) = _edit.Id is int id
            ? await Api.UpdateAmcContractAsync(id, _edit)
            : await Api.UpsertAmcContractAsync(_edit);
        if (data is null) Toast.ShowError(error ?? "Failed");
        else { Toast.ShowSuccess("Saved"); _edit = null; await LoadAsync(); }
    }

    private async Task DeleteAsync(int id)
    {
        var (ok, error, _) = await Api.DeleteAmcContractAsync(id);
        if (!ok) Toast.ShowError(error ?? "Failed");
        else { Toast.ShowSuccess("Deleted"); await LoadAsync(); }
    }
}
