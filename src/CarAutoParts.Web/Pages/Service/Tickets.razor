@page "/service/tickets"
@attribute [Authorize]
@using CarAutoParts.Web.Auth
@inject CapApiService Api
@inject IToastService Toast
@inject PermissionService Perms
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthState

<PageHeader Title="Service Tickets" Subtitle="Tickets, warranty claims, and AMC follow-ups (Service Light)" />
<LoadingState Busy="@_busy" Error="@_error" />

<div class="cap-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <select class="form-select" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Open">Open</option>
                <option value="InProgress">In progress</option>
                <option value="Resolved">Resolved</option>
                <option value="Closed">Closed</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Priority</label>
            <select class="form-select" @bind="_filterPriority">
                <option value="">All</option>
                <option value="Low">Low</option>
                <option value="Normal">Normal</option>
                <option value="High">High</option>
                <option value="Urgent">Urgent</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Customer</label>
            <select class="form-select" @bind="_filterCustomer">
                <option value="0">All customers</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">SLA</label>
            <select class="form-select" @bind="_filterSla">
                <option value="">All</option>
                <option value="warning">Warning</option>
                <option value="breached">Breached</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Assignee</label>
            <select class="form-select" @bind="_filterAssignee">
                <option value="0">All</option>
                <option value="-1">Unassigned</option>
                <option value="-2">Mine</option>
                @foreach (var u in _users)
                {
                    <option value="@u.Id">@(u.DisplayName ?? u.Username)</option>
                }
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-outline-light w-100" @onclick="LoadAsync">Filter</button></div>
    </div>
</div>

@if (_canManage)
{
    <div class="cap-card mb-3">
        <h6 class="mb-2">New ticket</h6>
        <div class="row g-2">
            <div class="col-md-3">
                <select class="form-select" @bind="_form.CustomerId">
                    <option value="0">Customer *</option>
                    @foreach (var c in _customers)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><input class="form-control" placeholder="Subject *" @bind="_form.Subject" /></div>
            <div class="col-md-2">
                <select class="form-select" @bind="_form.Priority">
                    <option value="0">Low</option>
                    <option value="1">Normal</option>
                    <option value="2">High</option>
                    <option value="3">Urgent</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="_formAssignee">
                    <option value="0">Unassigned</option>
                    @foreach (var u in _users)
                    {
                        <option value="@u.Id">@(u.DisplayName ?? u.Username)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_formProductId">
                    <option value="0">Product (optional)</option>
                    @foreach (var p in _products)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2"><button class="btn btn-cap w-100" disabled="@_saving" @onclick="CreateAsync">Add</button></div>
            <div class="col-md-6">
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="warrantyChk" @bind="_form.IsWarrantyClaim" />
                    <label class="form-check-label" for="warrantyChk">Warranty claim</label>
                </div>
            </div>
            @if (_form.IsWarrantyClaim)
            {
                <div class="col-md-3"><input class="form-control" placeholder="Warranty reference" @bind="_form.WarrantyReference" /></div>
            }
            <div class="col-md-3"><input class="form-control" placeholder="AMC reference (optional)" @bind="_form.AmcReference" /></div>
            <div class="col-md-3">
                <select class="form-select" @bind="_formAmcId" title="AMC contract">
                    <option value="0">AMC contract…</option>
                    @foreach (var a in _amcOptions)
                    {
                        <option value="@a.Id">@a.ContractNumber</option>
                    }
                </select>
            </div>
            @if (_canManage)
            {
                <div class="col-md-3">
                    <select class="form-select" @bind="_formSlaPolicyId" title="SLA policy override">
                        <option value="0">SLA policy (auto)</option>
                        @foreach (var p in _slaPolicies)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
            }
        </div>
    </div>
}

@if (_items is not null)
{
    @if (_items.Items.Count == 0)
    {
        <EmptyState Title="No tickets yet" Message="Log a service ticket, warranty claim, or AMC follow-up above." />
    }
    else
    {
        <div class="cap-card table-responsive">
            <table class="table table-cap table-striped mb-0">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>SLA</th>
                        <th>Assignee</th>
                        <th>Warranty</th>
                        <th>Opened</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in _items.Items)
                {
                    <tr style="cursor:pointer" @onclick="() => OpenTicket(t.Id)">
                        <td>@t.Subject</td>
                        <td>@(t.CustomerName ?? "—")</td>
                        <td>@(t.IsWarrantyClaim ? "Warranty" : (string.IsNullOrWhiteSpace(t.AmcReference) ? "General" : "AMC"))</td>
                        <td><span class="badge badge-soft">@PriorityLabel(t.Priority)</span></td>
                        <td><span class="badge badge-soft">@StatusLabel(t.Status)</span></td>
                        <td><span class="badge badge-soft">@(_slaBadges.GetValueOrDefault(t.Id, "—"))</span></td>
                        <td>@AssigneeName(t.AssignedToUserId)</td>
                        <td>@(t.IsWarrantyClaim ? WarrantyClaimLabel(t.WarrantyClaimStatus) : "—")</td>
                        <td>@t.OpenedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool _busy = true;
    private bool _saving;
    private string? _error;
    private bool _canManage;
    private PagedResult<ServiceTicketDto>? _items;
    private ServiceTicketCreateDto _form = new() { Priority = 1 };
    private int _formAssignee;
    private int _formProductId;
    private int _formAmcId;
    private int _formSlaPolicyId;
    private List<SlaPolicyDto> _slaPolicies = new();
    private List<AmcContractDto> _amcAll = [];
    private IEnumerable<AmcContractDto> _amcOptions =>
        _form.CustomerId > 0 ? _amcAll.Where(a => a.CustomerId == _form.CustomerId && a.Status == 1) : [];
    private string _filterStatus = "";
    private string _filterPriority = "";
    private string _filterSla = "";
    private int _filterCustomer;
    private int _filterAssignee;
    private int _currentUserId;
    private List<CustomerDto> _customers = new();
    private List<UserDto> _users = new();
    private List<ProductListDto> _products = new();
    private Dictionary<int, string> _slaBadges = new();

    protected override async Task OnInitializedAsync()
    {
        _canManage = await Perms.HasAsync("service.manage");
        _currentUserId = (await AuthState.GetUserAsync())?.UserId ?? 0;
        var (customers, _, _) = await Api.GetCustomersAsync(new QuerySpec { Page = 1, PageSize = 500 });
        _customers = customers?.Items.ToList() ?? new();
        var (users, _, _) = await Api.GetUsersAsync();
        _users = users ?? new();
        var (products, _, _) = await Api.GetProductsAsync(new QuerySpec { Page = 1, PageSize = 500 });
        _products = products?.Items.ToList() ?? new();
        var (amc, _, _) = await Api.GetAmcContractsAsync(status: 1);
        _amcAll = amc ?? [];
        if (_canManage)
        {
            var (pols, _, _) = await Api.GetSlaPoliciesAsync(0);
            _slaPolicies = (pols ?? new()).Where(p => p.AppliesToEntityType == 0 && p.IsActive).ToList();
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            int? customerId = _filterCustomer > 0 ? _filterCustomer : null;
            int? assignedId = null;
            bool? unassigned = null;
            if (_filterAssignee == -1) unassigned = true;
            else if (_filterAssignee == -2 && _currentUserId > 0) assignedId = _currentUserId;
            else if (_filterAssignee > 0) assignedId = _filterAssignee;

            var (data, error, _) = await Api.GetServiceTicketsAsync(
                new QuerySpec { Page = 1, PageSize = 100 },
                string.IsNullOrWhiteSpace(_filterStatus) ? null : _filterStatus,
                string.IsNullOrWhiteSpace(_filterPriority) ? null : _filterPriority,
                customerId,
                assignedId,
                string.IsNullOrWhiteSpace(_filterSla) ? null : _filterSla,
                unassigned);
            if (error is not null) { _error = error; return; }
            _items = data;
            _slaBadges = new();
            if (_items?.Items is { Count: > 0 } list)
            {
                foreach (var t in list.Take(40))
                {
                    var (sla, _, _) = await Api.GetTicketSlaAsync(t.Id);
                    if (sla is null) continue;
                    _slaBadges[t.Id] = SlaBadge(sla);
                }
            }
        }
        finally { _busy = false; }
    }

    private static string SlaBadge(SlaTicketSummaryDto sla)
    {
        if (sla.Timers.Any(t => t.Status == 3 || t.BreachedAt is not null)) return "Breached";
        if (sla.Timers.Any(t => t.WarnedAt is not null && t.Status == 0)) return "Warning";
        if (sla.Timers.Any(t => t.Status == 1)) return "Paused";
        var rem = sla.Timers.Where(t => t.Status == 0).Select(t => t.RemainingSeconds).DefaultIfEmpty(0).Min();
        if (rem <= 0 && sla.Timers.Any(t => t.Status == 0)) return "Due";
        return rem > 0 ? FormatRem(rem) : "Ok";
    }

    private static string FormatRem(int seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1 ? $"{(int)ts.TotalHours}h" : $"{ts.Minutes}m";
    }

    private async Task CreateAsync()
    {
        if (_form.CustomerId <= 0 || string.IsNullOrWhiteSpace(_form.Subject))
        {
            Toast.ShowWarning("Customer and subject are required.");
            return;
        }

        _saving = true;
        try
        {
            _form.AssignedToUserId = _formAssignee > 0 ? _formAssignee : null;
            _form.ProductId = _formProductId > 0 ? _formProductId : null;
            _form.AmcContractId = _formAmcId > 0 ? _formAmcId : null;
            _form.SlaPolicyId = _formSlaPolicyId > 0 ? _formSlaPolicyId : null;
            var (data, error, _) = await Api.CreateServiceTicketAsync(_form);
            if (error is not null || data is null)
            {
                Toast.ShowError(error ?? "Could not create ticket.");
                return;
            }

            Toast.ShowSuccess($"Ticket '{data.Subject}' created. SLA timers started.");
            _form = new ServiceTicketCreateDto { Priority = 1 };
            _formAssignee = 0;
            _formProductId = 0;
            _formAmcId = 0;
            _formSlaPolicyId = 0;
            await LoadAsync();
        }
        finally { _saving = false; }
    }

    private void OpenTicket(int id) => Nav.NavigateTo($"/service/tickets/{id}");

    private string AssigneeName(int? id) =>
        id is null ? "—" : (_users.FirstOrDefault(u => u.Id == id)?.DisplayName
            ?? _users.FirstOrDefault(u => u.Id == id)?.Username ?? id.ToString()!);

    private static string StatusLabel(int status) => status switch
    {
        0 => "Open", 1 => "In progress", 2 => "Resolved", 3 => "Closed", _ => status.ToString()
    };

    private static string PriorityLabel(int priority) => priority switch
    {
        0 => "Low", 1 => "Normal", 2 => "High", 3 => "Urgent", _ => priority.ToString()
    };

    private static string WarrantyClaimLabel(int s) => s switch
    {
        1 => "Submitted", 2 => "Approved", 3 => "Rejected", _ => "—"
    };
}
