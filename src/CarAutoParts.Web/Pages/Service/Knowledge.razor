@page "/service/kb"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast
@inject PermissionService Perms

<PageHeader Title="Knowledge Base" Subtitle="Internal service articles (not a customer portal)">
    @if (_canManage)
    {
        <button type="button" class="btn btn-cap btn-sm" @onclick="StartNew">New article</button>
    }
</PageHeader>

<LoadingState Busy="@_busy" Error="@_error" />

<div class="cap-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label">Search</label>
            <input class="form-control" @bind="_search" @bind:event="oninput" placeholder="Title, tags, body…" />
        </div>
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-light w-100" @onclick="LoadAsync">Search</button>
        </div>
    </div>
</div>

@if (_edit is not null && _canManage)
{
    <div class="cap-card mb-3">
        <h6>@(_edit.Id is > 0 ? "Edit article" : "New article")</h6>
        <div class="row g-2">
            <div class="col-md-8"><label class="form-label">Title</label><input class="form-control" @bind="_edit.Title" /></div>
            <div class="col-md-4"><label class="form-label">Category</label><input class="form-control" @bind="_edit.Category" /></div>
            <div class="col-md-8"><label class="form-label">Tags</label><input class="form-control" @bind="_edit.Tags" placeholder="comma-separated" /></div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="kbPub" @bind="_edit.IsPublished" />
                    <label class="form-check-label" for="kbPub">Published</label>
                </div>
            </div>
            <div class="col-12"><label class="form-label">Body</label><textarea class="form-control" rows="6" @bind="_edit.Body"></textarea></div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="button" class="btn btn-cap" @onclick="SaveAsync">Save</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => _edit = null">Cancel</button>
        </div>
    </div>
}

@if (_items is not null)
{
    @if (_items.Count == 0)
    {
        <EmptyState Title="No articles" Message="Create an internal how-to for common ticket issues." />
    }
    else
    {
        <div class="cap-card">
            @foreach (var a in _items)
            {
                <div class="cap-list-row">
                    <div class="cap-list-label">
                        <strong>@a.Title</strong>
                        <div class="small text-secondary">
                            @(a.Category ?? "General")
                            @if (!string.IsNullOrWhiteSpace(a.Tags)) { <span> · @a.Tags</span> }
                            @if (!a.IsPublished) { <span class="badge badge-soft ms-1">Draft</span> }
                        </div>
                        @if (_expandedId == a.Id)
                        {
                            <pre class="small mt-2 mb-0 text-wrap" style="white-space: pre-wrap;">@a.Body</pre>
                        }
                    </div>
                    <div class="cap-actions">
                        <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => ToggleExpand(a.Id)">
                            @(_expandedId == a.Id ? "Hide" : "View")
                        </button>
                        @if (_canManage)
                        {
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => Edit(a)">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(a.Id)">Del</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private bool _busy = true;
    private string? _error;
    private bool _canManage;
    private string? _search;
    private List<KbArticleDto>? _items;
    private KbArticleUpsertDto? _edit;
    private int? _expandedId;

    protected override async Task OnInitializedAsync()
    {
        _canManage = await Perms.HasAsync("service.manage");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var (data, error, _) = await Api.GetKbArticlesAsync(_search, publishedOnly: !_canManage);
            _items = data;
            _error = error;
        }
        finally { _busy = false; }
    }

    private void StartNew() =>
        _edit = new KbArticleUpsertDto { IsPublished = true };

    private void Edit(KbArticleDto a) =>
        _edit = new KbArticleUpsertDto
        {
            Id = a.Id,
            Title = a.Title,
            Category = a.Category,
            Body = a.Body,
            Tags = a.Tags,
            IsPublished = a.IsPublished
        };

    private void ToggleExpand(int id) =>
        _expandedId = _expandedId == id ? null : id;

    private async Task SaveAsync()
    {
        if (_edit is null) return;
        var (data, error, _) = await Api.UpsertKbArticleAsync(_edit);
        if (error is not null || data is null) { Toast.ShowError(error ?? "Save failed"); return; }
        Toast.ShowSuccess("Article saved");
        _edit = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var (ok, error, _) = await Api.DeleteKbArticleAsync(id);
        if (!ok) Toast.ShowError(error ?? "Delete failed");
        else { Toast.ShowSuccess("Deleted"); await LoadAsync(); }
    }
}
