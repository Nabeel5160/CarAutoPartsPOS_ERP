@page "/fbr"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="FBR Invoicing" Subtitle="POST /api/fbr/invoices + submission history" />

<div class="cap-card mb-3">
    <p class="text-secondary">Posts a minimal invoice payload to the FBR service (sandbox/stub when token empty).</p>
    <div class="row g-2">
        <div class="col-md-4"><input class="form-control" placeholder="Buyer name" @bind="_buyer" /></div>
        <div class="col-md-4"><input class="form-control" placeholder="Scenario" @bind="_scenario" /></div>
        <div class="col-md-4"><button class="btn btn-cap w-100" @onclick="PostAsync" disabled="@_busy">@(_busy ? "Posting…" : "Post invoice")</button></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_result))
    {
        <pre class="mt-3 alert-cap p-3 rounded small">@_result</pre>
    }
</div>

<LoadingState Busy="@_historyBusy" Error="@_historyError" />

@if (_submissions is not null)
{
    <div class="cap-card table-responsive">
        <h5>FBR submission history</h5>
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Invoice</th><th>FBR #</th><th>Status</th><th>Submitted</th><th>Error</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var s in _submissions)
            {
                <tr>
                    <td>@(s.InvoiceNumber ?? s.SalesInvoiceId.ToString())</td>
                    <td class="mono">@(s.FbrInvoiceNumber ?? "—")</td>
                    <td>@s.Status</td>
                    <td>@s.SubmittedAt.ToLocalTime().ToString("g")</td>
                    <td class="small text-secondary">@(s.ErrorMessage ?? "—")</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            @if (s.Status is 2)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => RetryAsync(s.SalesInvoiceId)">Retry</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private string _buyer = "Walk-in Customer";
    private string _scenario = "SN001";
    private bool _busy;
    private string? _result;
    private List<FbrSubmissionDto>? _submissions;
    private bool _historyBusy = true;
    private string? _historyError;

    protected override async Task OnInitializedAsync() => await LoadHistoryAsync();

    private async Task LoadHistoryAsync()
    {
        _historyBusy = true;
        var (data, error, _) = await Api.GetFbrSubmissionsAsync();
        _submissions = data;
        _historyError = error;
        _historyBusy = false;
    }

    private async Task PostAsync()
    {
        _busy = true;
        var payload = new
        {
            invoiceType = "Sale Invoice",
            invoiceDate = DateTime.Today.ToString("yyyy-MM-dd"),
            sellerNTNCNIC = "0786909",
            sellerBusinessName = "Demo Mart (Pvt) Ltd",
            sellerProvince = "Sindh",
            sellerAddress = "Karachi",
            buyerNTNCNIC = "",
            buyerBusinessName = _buyer,
            buyerProvince = "Sindh",
            buyerAddress = "N/A",
            buyerRegistrationType = "Unregistered",
            invoiceRefNo = "",
            scenarioId = _scenario,
            items = Array.Empty<object>()
        };
        var (data, error, _) = await Api.PostFbrInvoiceAsync(payload);
        _busy = false;
        _result = error ?? System.Text.Json.JsonSerializer.Serialize(data);
        if (error is null) Toast.ShowSuccess("FBR call completed");
        else Toast.ShowError(error);
        await LoadHistoryAsync();
    }

    private async Task RetryAsync(int invoiceId)
    {
        var (ok, error, _) = await Api.RetryFbrAsync(invoiceId);
        if (!ok) Toast.ShowError(error ?? "Retry failed");
        else { Toast.ShowSuccess("Retry enqueued"); await LoadHistoryAsync(); }
    }
}
