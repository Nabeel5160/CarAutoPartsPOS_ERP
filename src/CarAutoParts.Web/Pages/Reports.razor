    private string? _dailyDayFilter;

    private IEnumerable<DailySalesDayRowDto> FilteredDailyDays =>
        _daily is null ? [] :
        string.IsNullOrWhiteSpace(_dailyDayFilter)
            ? _daily.Days
            : _daily.Days.Where(d => d.Date.ToString("dd MMM").Equals(_dailyDayFilter, StringComparison.OrdinalIgnoreCase)
                                     || d.Date.ToString("yyyy-MM-dd").Equals(_dailyDayFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<SalesDimRowDto> FilteredSalesDimRows =>
        _salesDim is null ? [] :
        string.IsNullOrWhiteSpace(_salesDimFilter)
            ? _salesDim.Rows
            : _salesDim.Rows.Where(r => r.Label.Contains(_salesDimFilter, StringComparison.OrdinalIgnoreCase));

    private bool NeedsDateRange => Current?.NeedsDates != false && _type is not "inventory" and not "purchasing-pipeline" and not "aging" and not "stock-aging";
    private bool NeedsBranch => Current?.NeedsBranch == true;
    private bool HasGrid => Current?.HasGrid == true;
    private ReportTab? Current => AllTabs.FirstOrDefault(t => t.Type == _type);
    private int? BranchOpt => int.TryParse(_branchId, out var b) ? b : null;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        var me = await Auth.MeAsync();
        if (me.Data?.AllowedBranchIds is { Count: > 0 } ids)
            _branches = ids;
        else if (me.Data?.BranchId is int b)
            _branches = [b];
        var uriBefore = Nav.Uri;
        ApplyTypeFromUri();
        // Defaulting ?type=… navigates; skip the LocationChanged reload — we load below.
        if (!string.Equals(uriBefore, Nav.Uri, StringComparison.Ordinal))
            _suppressLocationLoad = true;
        if (HasGrid) await LoadAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyTypeFromUri();
        _ = InvokeAsync(async () =>
        {
            if (_suppressLocationLoad)
            {
                _suppressLocationLoad = false;
                StateHasChanged();
                return;
            }
            if (HasGrid) await LoadAsync();
            StateHasChanged();
        });
    }

    private void ApplyTypeFromUri()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var q = relative.IndexOf('?', StringComparison.Ordinal);
        string? type = null;
        if (q >= 0)
        {
            var query = relative[(q + 1)..];
            var hash = query.IndexOf('#', StringComparison.Ordinal);
            if (hash >= 0) query = query[..hash];
            foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var eq = part.IndexOf('=');
                if (eq < 0) continue;
                if (part[..eq].Equals("type", StringComparison.OrdinalIgnoreCase))
                {
                    type = Uri.UnescapeDataString(part[(eq + 1)..]);
                    break;
                }
            }
        }

        var normalized = NormalizeType(type);
        if (string.IsNullOrWhiteSpace(type))
        {
            SetType(normalized, updateUrl: true);
            return;
        }
        SetType(normalized, updateUrl: false);
    }

    private string NormalizeType(string? type)
    {
        if (string.IsNullOrWhiteSpace(type)) return "daily-sales";
        type = type.Trim().ToLowerInvariant();
        if (type == "product") return "sales-dim";
        if (!VisibleTabs.Any(t => t.Type == type)) return "daily-sales";
        return type;
    }

    private void SelectType(string type) => SetType(type, updateUrl: true);

    private void SetType(string type, bool updateUrl)
    {
        _type = NormalizeType(type);
        var tab = AllTabs.First(t => t.Type == _type);
        _title = tab.Title;
        _hint = tab.Hint;
        if (_type == "sales-dim") _dimension = "product";
        if (_type == "sales-staff") _dimension = "cashier";
        if (_type is "profit" or "profit-dim") _dimension = _type == "profit" ? "product" : "category";
        _selectedZ = null;
        _error = null;
        ClearChartSpecs();
        _salesDimFilter = null;
        _dailyDayFilter = null;

        if (!updateUrl) return;
        var target = $"reports?type={_type}";
        var current = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (!current.Equals(target, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(target);
    }

    private string BranchQuery => BranchOpt is int b ? $"&branchId={b}" : "";

    private async Task LoadAsync()
    {
        _busy = true; _error = null;
        ClearChartSpecs();
        _salesDimFilter = null;
        _dailyDayFilter = null;
        try
        {
            switch (_type)
            {
                case "daily-sales":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<DailySalesSummaryDto>("daily-sales",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}{BranchQuery}");
                    _daily = d; _error = e;
                    BuildDailyCharts();
                    break;
                }
                case "z-shifts":
                {
                    var (d, e, _) = await Api.GetClosedShiftsAsync(_from, _to, _tillId, BranchOpt);
                    _shifts = d ?? []; _error = e;
                    break;
                }
                case "sales-returns":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<SalesReturnsReportDto>("sales-returns",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}{BranchQuery}");
                    _returns = d; _error = e;
                    break;
                }
                case "sales-dim":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<SalesDimReportDto>("sales-dim",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&dimension={_dimension}{BranchQuery}");
                    _salesDim = d; _error = e;
                    BuildSalesDimCharts();
                    break;
                }
                case "sales-staff":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<SalesStaffReportDto>("sales-staff",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&dimension={_dimension}{BranchQuery}");
                    _salesStaff = d; _error = e;
                    BuildSalesStaffCharts();
                    break;
                }
                case "profit-dim":
                {
                    var dim = _dimension is "category" or "branch" ? _dimension : "category";
                    var (d, e, _) = await Api.GetReportJsonAsync<ProfitDimReportDto>("profit-dim",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&dimension={dim}{BranchQuery}");
                    _profitDim = d; _error = e;
                    BuildProfitDimCharts();
                    break;
                }
                case "movements":
                {
                    var mt = string.IsNullOrWhiteSpace(_movementType) ? "" : $"&movementType={_movementType}";
                    var (d, e, _) = await Api.GetReportJsonAsync<StockMovementReportDto>("movements",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}{mt}");
                    _movements = d; _error = e;
                    break;
                }
                case "purchasing-pipeline":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<PurchasingPipelineReportDto>("purchasing-pipeline",
                        $"?{BranchQuery.TrimStart('&')}");
                    _pipeline = d; _error = e;
                    break;
                }
                case "tax":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<TaxPeriodSummaryDto>("tax",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}{BranchQuery}");
                    _tax = d; _error = e;
                    BuildTaxCharts();
                    break;
                }
                case "fbr":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<FbrRegisterReportDto>("fbr",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}");
                    _fbr = d; _error = e;
                    break;
                }
                case "stock-aging":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<StockAgingReportDto>("stock-aging",
                        $"?asOf={_to:yyyy-MM-dd}{BranchQuery}");
                    _stockAging = d; _error = e;
                    BuildStockAgingCharts();
                    break;
                }
                case "sku-margin":
                {
                    var (d, e, _) = await Api.GetReportJsonAsync<SkuMarginReportDto>("sku-margin",
                        $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}{BranchQuery}");
                    _skuMargin = d; _error = e;
                    break;
                }
            }
        }
        finally { _busy = false; }
    }

    private void ClearChartSpecs()
    {
        _dailyLineSpec = _dailyTenderSpec = _salesDimDonutSpec = _salesDimBarSpec = null;
        _salesStaffSpec = _profitDimSpec = _taxSpec = _stockAgingSpec = null;
    }

    private void BuildDailyCharts()
    {
        if (_daily is null) return;
        var days = _daily.Days.OrderBy(d => d.Date).ToList();
        if (days.Count > 0)
        {
            var frames = days.Select((_, i) =>
            {
                var slice = days.Take(i + 1).ToList();
                return new CapChartFrame
                {
                    Label = days[i].Date.ToString("dd MMM"),
                    Labels = slice.Select(d => d.Date.ToString("dd MMM")).ToList(),
                    Datasets =
                    [
                        new CapChartDataset
                        {
                            Label = "Net sales",
                            Data = slice.Select(d => d.NetSales).ToList(),
                            ColorRole = "accent",
                            Fill = true
                        }
                    ]
                };
            }).ToList();
            _dailyLineSpec = CapChartFactory.Timeline(frames, "line", autoPlay: false);
            _dailyLineSpec.Type = "line";
        }

        if (_daily.Tenders.Count > 0)
            _dailyTenderSpec = CapChartFactory.Doughnut(
                _daily.Tenders.Select(t => t.Method),
                "Tenders",
                _daily.Tenders.Select(t => t.Amount));
    }

    private void BuildSalesDimCharts()
    {
        if (_salesDim is null) return;
        var top = _salesDim.Rows.OrderByDescending(r => r.Revenue).Take(12).ToList();
        if (top.Count == 0) return;
        _salesDimDonutSpec = CapChartFactory.Doughnut(top.Select(r => r.Label), "Revenue", top.Select(r => r.Revenue));
        _salesDimBarSpec = CapChartFactory.StackedBar(
            top.Select(r => Truncate(r.Label, 18)),
            ("Revenue", top.Select(r => r.Revenue), "accent"),
            ("Tax", top.Select(r => r.TaxAmount), "accent2"));
    }

    private void BuildSalesStaffCharts()
    {
        if (_salesStaff is null) return;
        var rows = _salesStaff.Rows.OrderBy(r => r.SalesTotal).Take(15).ToList();
        if (rows.Count == 0) return;
        _salesStaffSpec = CapChartFactory.HorizontalBar(
            rows.Select(r => Truncate(r.Label, 24)),
            "Sales",
            rows.Select(r => r.SalesTotal));
    }

    private void BuildProfitDimCharts()
    {
        if (_profitDim is null) return;
        var rows = _profitDim.Rows.OrderByDescending(r => r.Revenue).Take(12).ToList();
        if (rows.Count == 0) return;
        _profitDimSpec = CapChartFactory.DualBar(
            rows.Select(r => Truncate(r.Label, 18)),
            "Revenue", rows.Select(r => r.Revenue),
            "Profit", rows.Select(r => r.Profit));
    }

    private void BuildTaxCharts()
    {
        if (_tax is null || _tax.ByRate.Count == 0) return;
        _taxSpec = CapChartFactory.Doughnut(
            _tax.ByRate.Select(r => $"{r.TaxRate:0.##}%"),
            "Tax",
            _tax.ByRate.Select(r => r.TaxAmount));
    }

    private void BuildStockAgingCharts()
    {
        if (_stockAging is null || _stockAging.Rows.Count == 0) return;
        var buckets = _stockAging.Rows
            .GroupBy(r => string.IsNullOrWhiteSpace(r.Bucket) ? "Unknown" : r.Bucket)
            .Select(g => new { Bucket = g.Key, Value = g.Sum(x => x.Value), Qty = g.Sum(x => x.Quantity) })
            .OrderBy(x => x.Bucket)
            .ToList();
        _stockAgingSpec = CapChartFactory.StackedBar(
            buckets.Select(b => b.Bucket),
            ("Value", buckets.Select(b => b.Value), "accent"),
            ("Qty", buckets.Select(b => b.Qty), "accent2"));
    }

    private Task OnSalesDimSegmentClick((string Name, string Series, decimal Value) args)
    {
        _salesDimFilter = string.IsNullOrWhiteSpace(args.Name) ? null : args.Name;
        return Task.CompletedTask;
    }

    private void ClearSalesDimFilter() => _salesDimFilter = null;

    private static string Truncate(string value, int max)
        => string.IsNullOrEmpty(value) || value.Length <= max ? value : value[..(max - 1)] + "…";

    private async Task ViewZAsync(int shiftId)
    {
        var (z, error, _) = await Api.GetZReportAsync(shiftId);
        if (z is null) { Toast.ShowError(error ?? "Z failed"); return; }
        _selectedZ = z;
    }

    private async Task PrintZAsync()
    {
        await Js.InvokeVoidAsync("eval", "window.print()");
    }

    private async Task ExportAsync()
    {
        _busy = true;
        try
        {
            if (_type == "aging")
            {
                await ExportAgingAsync("customers");
                return;
            }

            if (_type == "profit" && _dimension is "category" or "branch")
            {
                var (pb, pe) = await Api.ExportReportAsync("profit-dim",
                    $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&dimension={_dimension}{BranchQuery}&format=xlsx");
                if (pb is null) { Toast.ShowError(pe ?? "Export failed"); return; }
                await Download(pb, "profit-dim.xlsx");
                return;
            }

            var (kind, query, fileName) = _type switch
            {
                "inventory" => ("inventory", $"?format=xlsx{BranchQuery}", "inventory.xlsx"),
                "purchases" => ("purchases", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx{BranchQuery}", "purchases.xlsx"),
                "profit" => ("profit", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx{BranchQuery}", "profit.xlsx"),
                "sales" => ("sales", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&period=daily&format=xlsx{BranchQuery}", "sales.xlsx"),
                "daily-sales" => ("daily-sales", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx{BranchQuery}", "daily-sales.xlsx"),
                "sales-returns" => ("sales-returns", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx{BranchQuery}", "sales-returns.xlsx"),
                "sales-dim" => ("sales-dim", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&dimension={_dimension}&format=xlsx{BranchQuery}", "sales-dim.xlsx"),
                "sales-staff" => ("sales-staff", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&dimension={_dimension}&format=xlsx{BranchQuery}", "sales-staff.xlsx"),
                "profit-dim" => ("profit-dim", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&dimension={_dimension}&format=xlsx{BranchQuery}", "profit-dim.xlsx"),
                "movements" => ("movements", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx{(string.IsNullOrWhiteSpace(_movementType) ? "" : $"&movementType={_movementType}")}", "movements.xlsx"),
                "purchasing-pipeline" => ("purchasing-pipeline", $"?format=xlsx{BranchQuery}", "purchasing-pipeline.xlsx"),
                "tax" => ("tax", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx{BranchQuery}", "tax.xlsx"),
                "fbr" => ("fbr", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx", "fbr.xlsx"),
                "stock-aging" => ("stock-aging", $"?asOf={_to:yyyy-MM-dd}&format=xlsx{BranchQuery}", "stock-aging.xlsx"),
                "sku-margin" => ("sku-margin", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=xlsx{BranchQuery}", "sku-margin.xlsx"),
                "z-shifts" => ("z-shifts",
                    $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}{BranchQuery}{(_tillId is int tid ? $"&tillId={tid}" : "")}&format=xlsx",
                    "z-shifts.xlsx"),
                _ => ("sales", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&period=daily&format=xlsx{BranchQuery}", "sales.xlsx"),
            };

            var (bytes, error) = await Api.ExportReportAsync(kind, query);
            if (bytes is null) { Toast.ShowError(error ?? "Export failed"); return; }
            await Download(bytes, fileName);
        }
        finally { _busy = false; }
    }

    private async Task ExportPdfAsync()
    {
        _busy = true;
        try
        {
            var (kind, query, fileName) = _type switch
            {
                "inventory" => ("inventory", $"?format=pdf{BranchQuery}", "inventory.pdf"),
                "daily-sales" => ("daily-sales", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format=pdf{BranchQuery}", "daily-sales.pdf"),
                _ => ("sales", $"?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&period=daily&format=pdf{BranchQuery}", "sales.pdf"),
            };
            var (bytes, error) = await Api.ExportReportAsync(kind, query);
            if (bytes is null) { Toast.ShowError(error ?? "PDF failed"); return; }
            await Js.InvokeVoidAsync("capDownload", Convert.ToBase64String(bytes), fileName, "application/pdf");
            Toast.ShowSuccess("PDF download started");
        }
        finally { _busy = false; }
    }

    private async Task ExportAgingAsync(string kind)
    {
        _busy = true;
        try
        {
            var (bytes, error) = await Api.ExportReportAsync("aging", $"?kind={kind}&format=xlsx");
            if (bytes is null) { Toast.ShowError(error ?? "Export failed"); return; }
            await Download(bytes, $"aging-{kind}.xlsx");
        }
        finally { _busy = false; }
    }

    private async Task Download(byte[] bytes, string fileName)
    {
        await Js.InvokeVoidAsync("capDownload", Convert.ToBase64String(bytes), fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        Toast.ShowSuccess("Download started");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private sealed record ReportTab(string Type, string Label, string Title, string Hint, bool NeedsDates, bool NeedsBranch, bool HasGrid);
}
