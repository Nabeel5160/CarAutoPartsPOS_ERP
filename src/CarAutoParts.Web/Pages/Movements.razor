@page "/movements"
@attribute [Authorize]
@inject CapApiService Api

<PageHeader Title="Stock Movements" Subtitle="Purchase, sale, return, adjustment, and transfer history" />
<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Date</th><th>Product</th><th>Warehouse</th><th>Type</th><th>Qty</th><th>Cost</th><th>Ref</th></tr></thead>
            <tbody>
            @foreach (var m in _items.Items)
            {
                <tr>
                    <td>@m.MovementDate.ToLocalTime().ToString("g")</td>
                    <td>@m.ProductName</td>
                    <td>@m.WarehouseName</td>
                    <td><span class="badge badge-soft">@TypeLabel(m.MovementType)</span></td>
                    <td>@m.Quantity.ToString("N2")</td>
                    <td>@m.UnitCost.ToString("N2")</td>
                    <td>@(string.IsNullOrEmpty(m.ReferenceType) ? "—" : $"{m.ReferenceType} #{m.ReferenceId}")</td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_items.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@code {
    private PagedResult<StockMovementDto>? _items;
    private bool _busy = true;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 10;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var (data, error, _) = await Api.GetMovementsAsync(_page, _pageSize);
            _items = data;
            _error = error;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = null;
        }
        finally { _busy = false; }
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }

    private static string TypeLabel(int type) => type switch
    {
        0 => "Purchase",
        1 => "Sale",
        2 => "Return",
        3 => "Adjustment",
        4 => "Transfer",
        _ => type.ToString()
    };
}
