@page "/movements"
@attribute [Authorize]
@inject CapApiService Api

<PageHeader Title="Stock Movements" Subtitle="GET /api/inventory/movements" />
<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Date</th><th>Product</th><th>Warehouse</th><th>Type</th><th>Qty</th><th>Cost</th><th>Ref</th></tr></thead>
            <tbody>
            @foreach (var m in _items.Items)
            {
                <tr>
                    <td>@m.MovementDate.ToLocalTime().ToString("g")</td>
                    <td>@m.ProductName</td><td>@m.WarehouseName</td><td>@m.MovementType</td>
                    <td>@m.Quantity</td><td>@m.UnitCost.ToString("N2")</td>
                    <td>@m.ReferenceType #@m.ReferenceId</td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_items.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@code {
    private PagedResult<StockMovementDto>? _items;
    private bool _busy = true;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 10;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetMovementsAsync(_page, _pageSize);
        _items = data; _error = error; _busy = false;
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }
}
