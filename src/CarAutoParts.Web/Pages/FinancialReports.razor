@page "/financial-reports"
@attribute [Authorize]
@inject CapApiService Api
@inject AuthApiService Auth
@inject IJSRuntime Js
@inject IToastService Toast

<PageHeader Title="Financial reports" Subtitle="Trial balance, P&amp;L, balance sheet" />
<LoadingState Busy="@_busy" Error="@_error" />

<div class="cap-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Branch (TB / P&amp;L)</label>
            <select class="form-select" @bind="_branchId">
                <option value="">All cost centers</option>
                @foreach (var b in _branches)
                {
                    <option value="@b">Branch @b</option>
                }
            </select>
        </div>
        <div class="col-md-9 d-flex flex-wrap gap-2">
            <button class="btn btn-cap" @onclick="LoadTbAsync">Trial balance</button>
            <button class="btn btn-outline-light" @onclick="LoadPlAsync">Profit &amp; loss</button>
            <button class="btn btn-outline-light" @onclick="LoadBsAsync">Balance sheet</button>
        </div>
    </div>
</div>

@if (_tb is not null)
{
    <div class="cap-card mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Trial balance @(_tb.AsOfDate.ToString("yyyy-MM-dd"))</h5>
            <button class="btn btn-sm btn-outline-light" @onclick="ExportTbCsvAsync">Export CSV</button>
        </div>
        <p>Total Dr @_tb.TotalDebit.ToString("N2") / Cr @_tb.TotalCredit.ToString("N2")</p>
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Code</th><th>Name</th><th>Debit</th><th>Credit</th></tr></thead>
            <tbody>
            @foreach (var l in _tb.Lines)
            {
                <tr><td>@l.Code</td><td>@l.Name</td><td>@l.Debit.ToString("N2")</td><td>@l.Credit.ToString("N2")</td></tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_pl is not null)
{
    <CapViewToggle Mode="_view" ModeChanged="OnViewChanged" CssClass="mb-3" />

    @if (_view == CapViewMode.Graphs)
    {
        <div class="cap-card mb-3">
            <CapChart Title="P&amp;L amounts" Spec="@_plChartSpec" Height="260" />
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-4"><div class="cap-card cap-kpi"><span class="label">Revenue</span><span class="value">@_pl.TotalRevenue.ToString("N0")</span></div></div>
            <div class="col-md-4"><div class="cap-card cap-kpi"><span class="label">Expense</span><span class="value">@_pl.TotalExpenses.ToString("N0")</span></div></div>
            <div class="col-md-4"><div class="cap-card cap-kpi"><span class="label">Net</span><span class="value">@_pl.NetProfit.ToString("N0")</span></div></div>
        </div>
    }

    @if (_view == CapViewMode.Numbers)
    {
        <div class="cap-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">P&amp;L @_pl.FromDate.ToString("yyyy-MM-dd") – @_pl.ToDate.ToString("yyyy-MM-dd")</h5>
                <button class="btn btn-sm btn-outline-light" @onclick="ExportPlCsvAsync">Export CSV</button>
            </div>
            <p>Revenue @_pl.TotalRevenue.ToString("N2") · Expense @_pl.TotalExpenses.ToString("N2") · Net @_pl.NetProfit.ToString("N2")</p>
            <table class="table table-cap table-striped mb-0">
                <thead><tr><th>Code</th><th>Name</th><th>Amount</th></tr></thead>
                <tbody>
                @foreach (var l in _pl.Lines)
                {
                    <tr><td>@l.Code</td><td>@l.Name</td><td>@l.Amount.ToString("N2")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="mb-3">
            <button class="btn btn-sm btn-outline-light" @onclick="ExportPlCsvAsync">Export CSV</button>
        </div>
    }
}

@if (_bs is not null)
{
    <div class="cap-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Balance sheet @_bs.AsOfDate.ToString("yyyy-MM-dd")</h5>
            <button class="btn btn-sm btn-outline-light" @onclick="ExportBsCsvAsync">Export CSV</button>
        </div>
        <p>Assets @_bs.TotalAssets.ToString("N2") · Liabilities @_bs.TotalLiabilities.ToString("N2") · Equity @_bs.TotalEquity.ToString("N2")</p>
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Code</th><th>Name</th><th>Balance</th></tr></thead>
            <tbody>
            @foreach (var l in _bs.Lines)
            {
                <tr><td>@l.Code</td><td>@l.Name</td><td>@l.Balance.ToString("N2")</td></tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private TrialBalanceReportDto? _tb;
    private ProfitAndLossReportDto? _pl;
    private BalanceSheetReportDto? _bs;
    private CapChartSpec? _plChartSpec;
    private List<int> _branches = [];
    private string _branchId = "";
    private bool _busy;
    private string? _error;
    private CapViewMode _view = CapViewMode.Numbers;

    private void OnViewChanged(CapViewMode mode) => _view = mode;

    protected override async Task OnInitializedAsync()
    {
        var me = await Auth.MeAsync();
        if (me.Data?.AllowedBranchIds is { Count: > 0 } ids)
            _branches = ids;
        else if (me.Data?.BranchId is int b)
            _branches = [b];
    }

    private int? SelectedBranch => int.TryParse(_branchId, out var b) ? b : null;

    private async Task LoadTbAsync()
    {
        _busy = true; _error = null;
        _plChartSpec = null;
        var (data, error, _) = await Api.GetTrialBalanceAsync(branchId: SelectedBranch);
        _tb = data; _error = error; _busy = false;
    }

    private async Task LoadPlAsync()
    {
        _busy = true; _error = null;
        var to = DateTime.Today;
        var from = to.AddMonths(-1);
        var (data, error, _) = await Api.GetProfitLossAsync(from, to, SelectedBranch);
        _pl = data; _error = error;
        BuildPlChart();
        _busy = false;
    }

    private async Task LoadBsAsync()
    {
        _busy = true; _error = null;
        _plChartSpec = null;
        var (data, error, _) = await Api.GetBalanceSheetAsync();
        _bs = data; _error = error; _busy = false;
    }

    private void BuildPlChart()
    {
        _plChartSpec = null;
        if (_pl is null) return;
        var rows = _pl.Lines
            .Where(l => Math.Abs(l.Amount) > 0)
            .OrderByDescending(l => Math.Abs(l.Amount))
            .Take(12)
            .ToList();
        if (rows.Count == 0) return;
        _plChartSpec = CapChartFactory.HorizontalBar(
            rows.Select(r => r.Name.Length > 28 ? r.Name[..27] + "…" : r.Name),
            "Amount",
            rows.Select(r => r.Amount));
    }

    private async Task ExportTbCsvAsync()
    {
        if (_tb is null) { Toast.ShowError("Load trial balance first"); return; }
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Code,Name,Debit,Credit");
        foreach (var l in _tb.Lines)
            sb.AppendLine($"{CsvExportHelper.Escape(l.Code)},{CsvExportHelper.Escape(l.Name)},{l.Debit},{l.Credit}");
        await DownloadCsvAsync(sb.ToString(), $"trial-balance-{_tb.AsOfDate:yyyyMMdd}.csv");
    }

    private async Task ExportPlCsvAsync()
    {
        if (_pl is null) { Toast.ShowError("Load P&L first"); return; }
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Code,Name,Amount");
        foreach (var l in _pl.Lines)
            sb.AppendLine($"{CsvExportHelper.Escape(l.Code)},{CsvExportHelper.Escape(l.Name)},{l.Amount}");
        await DownloadCsvAsync(sb.ToString(), $"profit-loss-{_pl.FromDate:yyyyMMdd}-{_pl.ToDate:yyyyMMdd}.csv");
    }

    private async Task ExportBsCsvAsync()
    {
        if (_bs is null) { Toast.ShowError("Load balance sheet first"); return; }
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Code,Name,Balance");
        foreach (var l in _bs.Lines)
            sb.AppendLine($"{CsvExportHelper.Escape(l.Code)},{CsvExportHelper.Escape(l.Name)},{l.Balance}");
        await DownloadCsvAsync(sb.ToString(), $"balance-sheet-{_bs.AsOfDate:yyyyMMdd}.csv");
    }

    private async Task DownloadCsvAsync(string csv, string fileName)
    {
        var bytes = CsvExportHelper.ToUtf8Bytes(csv);
        await Js.InvokeVoidAsync("capDownload", Convert.ToBase64String(bytes), fileName, "text/csv");
        Toast.ShowSuccess("CSV download started");
    }
}
