@page "/brands"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="Brands" Subtitle="GET/POST/PUT/DELETE /api/brands">
    <button class="btn btn-cap btn-sm" @onclick="() => BeginEdit(null)">Add brand</button>
</PageHeader>
<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Name</th><th>Active</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var b in _items)
            {
                <tr>
                    <td>@b.Name</td>
                    <td>@(b.IsActive ? "Yes" : "No")</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => BeginEdit(b)">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(b.Id)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_editing)
{
    <div class="cap-card mt-3">
        <div class="row g-2">
            <div class="col-md-6"><label class="form-label">Name</label><input class="form-control" @bind="_form.Name" /></div>
            <div class="col-md-4"><label class="form-label">Logo URL</label><input class="form-control" @bind="_form.LogoUrl" /></div>
            <div class="col-md-2 form-check mt-4"><InputCheckbox class="form-check-input" @bind-Value="_form.IsActive" /> Active</div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-cap" @onclick="SaveAsync">Save</button>
            <button class="btn btn-outline-light" @onclick="() => _editing = false">Cancel</button>
        </div>
    </div>
}

@code {
    private List<BrandDto>? _items;
    private bool _busy = true, _editing;
    private string? _error;
    private int? _editId;
    private BrandDto _form = new() { IsActive = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetBrandsAsync();
        _items = data; _error = error; _busy = false;
    }

    private void BeginEdit(BrandDto? b)
    {
        _editing = true;
        if (b is null) { _editId = null; _form = new BrandDto { IsActive = true }; return; }
        _editId = b.Id;
        _form = new BrandDto { Id = b.Id, Name = b.Name, LogoUrl = b.LogoUrl, IsActive = b.IsActive };
    }

    private async Task SaveAsync()
    {
        if (_editId is null)
        {
            var (_, error, _) = await Api.CreateBrandAsync(_form);
            if (error is not null) { Toast.ShowError(error); return; }
        }
        else
        {
            var (_, error, _) = await Api.UpdateBrandAsync(_editId.Value, _form);
            if (error is not null) { Toast.ShowError(error); return; }
        }
        _editing = false; await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var (ok, error, _) = await Api.DeleteBrandAsync(id);
        if (!ok) Toast.ShowError(error ?? "Failed"); else await LoadAsync();
    }
}
