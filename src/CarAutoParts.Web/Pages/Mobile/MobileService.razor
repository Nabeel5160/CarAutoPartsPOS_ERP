@page "/m/service"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast
@inject PermissionService Perms
@inject WebAppConfigService AppConfig

<div class="cap-mobile">
    <PageHeader Title="Service" Subtitle="Tickets and my visits">
        <a class="btn btn-sm btn-outline-light" href="m">← Mobile</a>
    </PageHeader>

    @if (!_allowed)
    {
        <div class="alert alert-warning">Service access required.</div>
    }
    else
    {
        <LoadingState Busy="@_busy" Error="@_error" />

        @if (_visits is { Count: > 0 })
        {
            <h6 class="mt-2">My visits today</h6>
            @foreach (var v in _visits)
            {
                <div class="cap-card mb-2">
                    <div class="fw-semibold">@(v.TicketSubject ?? $"Ticket #{v.ServiceTicketId}")</div>
                    <div class="small text-secondary">@v.ScheduledAt.ToLocalTime().ToString("g") · @VisitStatus(v.Status)</div>
                    @if (_canManage && v.Status is 0 or 1)
                    {
                        <button class="btn btn-sm btn-cap mt-2" @onclick="() => CompleteVisitAsync(v.Id)">Complete visit</button>
                    }
                    <div class="mt-1"><a class="small" href="@($"service/tickets/{v.ServiceTicketId}")">Open ticket</a></div>
                </div>
            }
        }

        <h6 class="mt-3">Open tickets</h6>
        @if (_items is not null)
        {
            @if (_items.Count == 0)
            {
                <EmptyState Title="All clear" Message="No open tickets." />
            }
            else
            {
                @foreach (var t in _items)
                {
                    <div class="cap-card mb-2">
                        <div class="fw-semibold">@t.Subject</div>
                        <div class="small text-secondary">@(t.CustomerName ?? "—") · @PriorityLabel(t.Priority)</div>
                        <div class="small text-secondary">@StatusLabel(t.Status) @(t.DueAt is DateTime d ? $"· due {d.ToLocalTime():g}" : "")</div>
                        @if (_slaRem.TryGetValue(t.Id, out var rem))
                        {
                            <div class="small">SLA @rem</div>
                        }
                        @if (_canManage && t.Status != 3)
                        {
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                @if (t.Status == 0)
                                {
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => SetStatusAsync(t.Id, 1)">Start</button>
                                }
                                <button class="btn btn-sm btn-cap" @onclick="() => SetStatusAsync(t.Id, 2)">Resolve</button>
                            </div>
                        }
                    </div>
                }
            }
        }

        <p class="cap-m-footnote mt-3"><a href="m">← Mobile hub</a> · <a href="service/tickets">Desktop tickets</a></p>
    }
</div>

@code {
    private bool _allowed;
    private bool _canManage;
    private bool _busy = true;
    private string? _error;
    private List<ServiceTicketDto>? _items;
    private List<ServiceVisitDto>? _visits;
    private Dictionary<int, string> _slaRem = new();

    protected override async Task OnInitializedAsync()
    {
        _allowed = await Perms.HasAsync("service.view") && AppConfig.ModuleEnabled(ModuleKeys.ServiceTickets);
        if (!_allowed) { _busy = false; return; }
        _canManage = await Perms.HasAsync("service.manage");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetServiceTicketsAsync(new QuerySpec { Page = 1, PageSize = 50 });
        _error = error;
        _items = data?.Items.Where(t => t.Status != 3).ToList() ?? new();
        var (visits, _, _) = await Api.GetMyServiceVisitsAsync(DateTime.UtcNow.Date);
        _visits = visits ?? [];
        _slaRem = new();
        foreach (var t in _items.Take(20))
        {
            var (sla, _, _) = await Api.GetTicketSlaAsync(t.Id);
            if (sla is null) continue;
            var rem = sla.Timers.Where(x => x.Status == 0).Select(x => x.RemainingSeconds).DefaultIfEmpty(0).Min();
            if (sla.Timers.Any(x => x.Status == 3)) _slaRem[t.Id] = "breached";
            else if (rem > 0) _slaRem[t.Id] = rem >= 3600 ? $"{rem / 3600}h" : $"{rem / 60}m";
        }
        _busy = false;
    }

    private async Task SetStatusAsync(int id, int status)
    {
        var (_, error, _) = await Api.ChangeServiceTicketStatusAsync(id, new ServiceTicketStatusChangeDto
        {
            Status = status,
            ResolutionNotes = status == 2 ? "Resolved on mobile" : null
        });
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess("Updated"); await LoadAsync(); }
    }

    private async Task CompleteVisitAsync(int id)
    {
        var (_, error, _) = await Api.ChangeServiceVisitStatusAsync(id, new ServiceVisitStatusDto { Status = 2 });
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess("Visit completed"); await LoadAsync(); }
    }

    private static string VisitStatus(int s) => s switch { 0 => "Scheduled", 1 => "In progress", 2 => "Done", 3 => "Cancelled", _ => s.ToString() };
    private static string StatusLabel(int s) => s switch { 0 => "Open", 1 => "In progress", 2 => "Resolved", 3 => "Closed", _ => s.ToString() };
    private static string PriorityLabel(int p) => p switch { 0 => "Low", 1 => "Normal", 2 => "High", 3 => "Urgent", _ => p.ToString() };
}
