@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthApiService Auth
@inject NavigationManager Nav
@inject ThemeService Theme
@inject WebAppConfigService AppConfig

<div class="cap-scene login-wrap">
    <div class="login-panel">
        <div class="cap-login-brand">
            @if (!string.IsNullOrWhiteSpace(AppConfig.ResolvedLogoUrl))
            {
                <img class="cap-brand-logo" src="@AppConfig.ResolvedLogoUrl" alt="" />
            }
            <h1 class="page-title mb-1 cap-brand-text">@AppConfig.Branding.ShortName <span style="color:var(--cap-accent)">@AppConfig.Branding.AccentWord</span></h1>
        </div>
        <p class="page-sub">Sign in to the ERP console</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-cap border-danger text-danger py-2">@_error</div>
        }

        @if (_mfaTicket is null)
        {
            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <InputText class="form-control" @bind-Value="_model.Username" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" class="form-control" @bind-Value="_model.Password" />
                </div>
                <button class="btn btn-cap w-100" disabled="@_busy">@(_busy ? "Signing in…" : "Sign in")</button>
            </EditForm>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Authenticator code</label>
                <input class="form-control" @bind="_mfaCode" maxlength="8" placeholder="6-digit or backup" />
            </div>
            <button class="btn btn-cap w-100" disabled="@_busy" @onclick="VerifyMfaAsync">@(_busy ? "Verifying…" : "Verify MFA")</button>
            <button type="button" class="btn btn-link btn-sm mt-2" @onclick="() => { _mfaTicket = null; _error = null; }">Back</button>
        }
        <div class="mt-3 small text-secondary">Default: admin / admin123</div>
    </div>
</div>

@code {
    private readonly LoginRequest _model = new() { Username = "admin", Password = "admin123" };
    private bool _busy;
    private string? _error;
    private string? _mfaTicket;
    private string _mfaCode = "";

    protected override async Task OnInitializedAsync() => await Theme.InitializeAsync();

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var (data, error) = await Auth.LoginAsync(_model.Username, _model.Password);
            if (data is null)
            {
                _error = error ?? "Invalid username or password.";
                return;
            }

            if (data.MfaRequired)
            {
                _mfaTicket = data.MfaTicket;
                return;
            }

            NavigateAfterLogin(data);
        }
        catch (Exception ex)
        {
            _error = "Sign-in failed: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task VerifyMfaAsync()
    {
        if (_mfaTicket is null) return;
        _busy = true;
        _error = null;
        var (data, error) = await Auth.VerifyMfaAsync(_mfaTicket, _mfaCode);
        _busy = false;
        if (data is null)
        {
            _error = error ?? "Invalid MFA code.";
            _mfaTicket = null; // ticket is single-use; force re-login
            return;
        }
        NavigateAfterLogin(data);
    }

    private void NavigateAfterLogin(ApiLoginResponse data)
    {
        // Password change is blocking for users flagged MustChangePassword (admin demo default).
        // MFA enroll is prompted for privileged users but can be skipped on /mfa-setup.
        // Counter cashiers go straight to /pos when nothing blocks them.
        var perms = data.User?.Permissions ?? [];
        if (data.User?.MustChangePassword == true)
            Nav.NavigateTo("/settings?forcePassword=1", true);
        else if (data.MustEnrollMfa || data.User?.MustEnrollMfa == true)
            Nav.NavigateTo("/mfa-setup", true);
        else if (perms.Any(p => p.Equals("pos.checkout", StringComparison.OrdinalIgnoreCase))
                 && !perms.Any(p =>
                     p.Equals("users.manage", StringComparison.OrdinalIgnoreCase)
                     || p.Equals("finance.manage", StringComparison.OrdinalIgnoreCase)
                     || p.Equals("platform.manage", StringComparison.OrdinalIgnoreCase)))
            Nav.NavigateTo("/pos", true);
        else
            Nav.NavigateTo("/", true);
    }
}
