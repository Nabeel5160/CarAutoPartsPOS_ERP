@page "/periods"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="Accounting periods" Subtitle="Close checklist gates draft journals and TB imbalance" />
<LoadingState Busy="@_busy" Error="@_error" />

@if (_checklist is not null)
{
    <div class="cap-card mb-3">
        <h5>Close checklist — @_checklist.PeriodName</h5>
        <ul>
            @foreach (var i in _checklist.Items)
            {
                <li class="@(i.IsBlocker && i.Count > 0 ? "text-warning" : "")">
                    @i.Label: @i.Count (@i.Severity)
                </li>
            }
        </ul>
        <button class="btn btn-cap me-2" disabled="@(!_checklist.CanClose)" @onclick="() => ConfirmCloseAsync(false)">Close</button>
        @if (_checklist.RequiresForceClose)
        {
            <button class="btn btn-outline-warning" @onclick="() => ConfirmCloseAsync(true)">Force close</button>
        }
        <button class="btn btn-outline-light ms-2" @onclick="() => _checklist = null">Cancel</button>
    </div>
}

@if (_periods is not null)
{
    <div class="cap-card">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>#</th><th>Name</th><th>Start</th><th>End</th><th>Status</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var p in _periods)
            {
                <tr>
                    <td>@p.PeriodNumber</td>
                    <td>@p.Name</td>
                    <td>@p.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@p.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>@(p.IsClosed ? "Closed" : "Open")</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            @if (p.IsClosed)
                            {
                                <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => ReopenAsync(p.Id)">Reopen</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => BeginCloseAsync(p.Id)">Close…</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AccountingPeriodDto>? _periods;
    private PeriodCloseChecklistDto? _checklist;
    private int _closingId;
    private bool _busy = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetPeriodsAsync();
        _periods = data; _error = error; _busy = false;
    }

    private async Task BeginCloseAsync(int id)
    {
        _closingId = id;
        var (data, error, _) = await Api.GetPeriodCloseChecklistAsync(id);
        if (data is null) Toast.ShowError(error ?? "Checklist failed");
        else _checklist = data;
    }

    private async Task ConfirmCloseAsync(bool force)
    {
        var (ok, error, _) = await Api.ClosePeriodAsync(_closingId, force);
        if (!ok) Toast.ShowError(error ?? "Close failed");
        else { Toast.ShowSuccess("Period closed"); _checklist = null; await ReloadAsync(); }
    }

    private async Task ReopenAsync(int id)
    {
        var (ok, error, _) = await Api.ReopenPeriodAsync(id);
        if (!ok) Toast.ShowError(error ?? "Reopen failed");
        else { Toast.ShowSuccess("Period reopened"); await ReloadAsync(); }
    }
}
