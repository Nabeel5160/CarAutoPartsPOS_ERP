@page "/settings"
@attribute [Authorize]
@inject CapApiService Api
@inject AuthApiService AuthApi
@inject ThemeService Theme
@inject LocaleService Locale
@inject WebAppConfigService AppConfig
@inject IToastService Toast
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthState

<PageHeader Title="Settings" Subtitle="@(_forcePassword ? "You must change the default password before continuing" : "Company settings + business profile + theme")" />
<LoadingState Busy="@_busy" Error="@_error" />

@if (_forcePassword)
{
    <div class="alert alert-cap border-danger">Default or temporary password detected. Update your password to unlock the rest of the app.</div>
}

@if (!_busy && string.IsNullOrWhiteSpace(_error) && _settings is null && !_forcePassword)
{
    <EmptyState Title="Settings unavailable"
                Message="Company settings did not load. Retry after checking API reachability, or sign in with an account that can view settings." />
}

@if (_settings is not null && !_forcePassword)
{
    <div class="cap-card mb-3">
        <h5 class="cap-section-title">Company</h5>
        <p class="cap-section-sub">Legal name, contact, tax defaults, and operational tolerances.</p>
        <div class="row g-2">
            <div class="col-md-6"><label class="form-label">Company</label><input class="form-control" @bind="_settings.CompanyName" /></div>
            <div class="col-md-3"><label class="form-label">City</label><input class="form-control" @bind="_settings.City" /></div>
            <div class="col-md-3"><label class="form-label">Phone</label><input class="form-control" @bind="_settings.Phone" /></div>
            <div class="col-md-4"><label class="form-label">Email</label><input class="form-control" @bind="_settings.Email" /></div>
            <div class="col-md-4"><label class="form-label">NTN</label><input class="form-control" @bind="_settings.Ntn" /></div>
            <div class="col-md-4"><label class="form-label">POS Id</label><input class="form-control" @bind="_settings.PosId" /></div>
            <div class="col-md-3"><label class="form-label">Default tax % (POS fallback when product tax is 0)</label><input type="number" class="form-control" @bind="_settings.DefaultTaxRate" /></div>
            <div class="col-md-3"><label class="form-label">API Theme field</label><input class="form-control" @bind="_settings.Theme" /></div>
            <div class="col-md-3"><label class="form-label">Default valuation</label>
                <select class="form-select" @bind="_settings.DefaultValuationMethod">
                    <option value="Average">Average</option>
                    <option value="Fifo">FIFO</option>
                </select>
            </div>
            <div class="col-md-3"><label class="form-label">GRN over-receive %</label><input type="number" class="form-control" @bind="_settings.GrnOverReceivePercent" /></div>
            <div class="col-md-3"><label class="form-label">3-way qty tol %</label><input type="number" class="form-control" @bind="_settings.ThreeWayQtyTolerancePercent" /></div>
            <div class="col-md-3"><label class="form-label">3-way price tol %</label><input type="number" class="form-control" @bind="_settings.ThreeWayPriceTolerancePercent" /></div>
            <div class="col-md-3 form-check mt-4">
                <input class="form-check-input" type="checkbox" id="grnUnder" @bind="_settings.GrnUnderReceiveAllowed" />
                <label class="form-check-label" for="grnUnder">Allow GRN under-receive</label>
            </div>
            <div class="col-md-3 form-check mt-4">
                <input class="form-check-input" type="checkbox" id="negStock" @bind="_settings.AllowNegativeStock" />
                <label class="form-check-label" for="negStock">Allow negative stock</label>
            </div>
            <div class="col-12"><label class="form-label">Address</label><textarea class="form-control" @bind="_settings.Address"></textarea></div>
            <div class="col-12"><label class="form-label">Invoice footer</label><input class="form-control" @bind="_settings.InvoiceFooter" placeholder="Thank you" /></div>
        </div>

        <h6 class="mt-3">Shop logo</h6>
        <p class="cap-section-sub mb-2">Shown in the sidebar, login screen, and POS receipt. PNG / JPG / WebP, max 2&nbsp;MB.</p>
        <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
            @if (!string.IsNullOrWhiteSpace(_logoPreviewUrl))
            {
                <img class="cap-logo-preview" src="@_logoPreviewUrl" alt="Shop logo" />
            }
            else
            {
                <div class="text-secondary small">No logo uploaded</div>
            }
            <div>
                <InputFile class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
                           OnChange="OnLogoSelectedAsync" disabled="@_logoBusy" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_settings.LogoUrl) || !string.IsNullOrWhiteSpace(_settings.LogoPath))
            {
                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_logoBusy" @onclick="RemoveLogoAsync">Remove logo</button>
            }
        </div>

        <button class="btn btn-cap mt-3" @onclick="SaveAsync">Save settings</button>
    </div>
}

@if (_cfg is not null && !_forcePassword)
{
    <div class="cap-card mb-3">
        <h5 class="cap-section-title">Business profile</h5>
        <p class="cap-section-sub">Pick a vertical preset, then override modules, fields, branding, and labels. Changes apply immediately after save.</p>
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label">Vertical</label>
                <select class="form-select" @bind="_selectedVertical">
                    @foreach (var v in _cfg.AvailableVerticals)
                    {
                        <option value="@v.Key">@v.DisplayName — @v.Description</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button class="btn btn-outline-warning" @onclick="ApplyPresetAsync">Apply preset defaults</button>
                <button class="btn btn-cap" @onclick="SaveConfigAsync">Save profile</button>
            </div>
        </div>

        <h6 class="mt-3">Branding</h6>
        <div class="row g-2 mb-3">
            <div class="col-md-3"><label class="form-label">App name</label><input class="form-control" @bind="_brandAppName" /></div>
            <div class="col-md-2"><label class="form-label">Short name</label><input class="form-control" @bind="_brandShort" /></div>
            <div class="col-md-2"><label class="form-label">Accent word</label><input class="form-control" @bind="_brandAccentWord" /></div>
            <div class="col-md-3">
                <label class="form-label">Logo URL <span class="text-secondary fw-normal">(from upload; optional external)</span></label>
                <input class="form-control" @bind="_brandLogo" readonly="@_logoFromUpload" title="@(_logoFromUpload ? "Synced from shop logo upload — clear upload or paste an external URL as advanced fallback" : "Optional external URL")" />
            </div>
            <div class="col-md-1"><label class="form-label">Theme</label><input class="form-control" @bind="_brandTheme" /></div>
            <div class="col-md-1"><label class="form-label">Accent</label><input class="form-control" @bind="_brandAccent" /></div>
            @if (_logoFromUpload)
            {
                <div class="col-12">
                    <button type="button" class="btn btn-link btn-sm px-0" @onclick="() => _logoFromUpload = false">Allow editing Logo URL (advanced)</button>
                </div>
            }
        </div>

        <h6>Modules</h6>
        <div class="row g-1 mb-3">
            @foreach (var key in _moduleKeys)
            {
                <div class="col-md-3 form-check">
                    <input class="form-check-input" type="checkbox" id="mod_@key" checked="@_modules.GetValueOrDefault(key)"
                           @onchange="e => _modules[key] = (bool)(e.Value ?? false)" />
                    <label class="form-check-label" for="mod_@key">@key</label>
                </div>
            }
        </div>

        <h6>Behaviors</h6>
        <div class="row g-2 mb-3">
            @foreach (var key in _behaviorBoolKeys)
            {
                <div class="col-md-3 form-check">
                    <input class="form-check-input" type="checkbox" id="beh_@key"
                           checked="@IsBehaviorOn(key)"
                           @onchange="e => SetBehavior(key, (bool)(e.Value ?? false))" />
                    <label class="form-check-label" for="beh_@key">@key</label>
                </div>
            }
            <div class="col-md-2"><label class="form-label">Currency</label><input class="form-control" @bind="_currency" /></div>
            <div class="col-md-2"><label class="form-label">Decimals</label><input class="form-control" @bind="_decimals" /></div>
        </div>

        <h6>Fields</h6>
        <div class="table-responsive mb-3">
            <table class="table table-cap table-sm">
                <thead><tr><th>Field</th><th>Visible</th><th>Required</th><th>Label</th></tr></thead>
                <tbody>
                @foreach (var key in _fieldKeys)
                {
                    var f = _fields[key];
                    <tr>
                        <td class="mono">@key</td>
                        <td><input type="checkbox" checked="@f.Visible" @onchange="e => f.Visible = (bool)(e.Value ?? false)" /></td>
                        <td><input type="checkbox" checked="@f.Required" @onchange="e => f.Required = (bool)(e.Value ?? false)" /></td>
                        <td><input class="form-control form-control-sm" @bind="f.Label" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <h6>Label overrides (en)</h6>
        <div class="row g-2">
            <div class="col-md-4"><label class="form-label">POS search placeholder</label><input class="form-control" @bind="_labelSearch" /></div>
            <div class="col-md-4"><label class="form-label">POS checkout</label><input class="form-control" @bind="_labelCheckout" /></div>
            <div class="col-md-4"><label class="form-label">Nav POS</label><input class="form-control" @bind="_labelNavPos" /></div>
        </div>
    </div>
}

<div class="cap-card mb-3">
    <h5>Change password</h5>
    <div class="row g-2">
        <div class="col-md-4"><input type="password" class="form-control" placeholder="Current" @bind="_currentPassword" /></div>
        <div class="col-md-4"><input type="password" class="form-control" placeholder="New password" @bind="_newPassword" /></div>
        <div class="col-md-4"><button class="btn btn-cap w-100" @onclick="ChangePasswordAsync">Update password</button></div>
    </div>
</div>

@if (!_forcePassword)
{
    <div class="cap-card mb-3">
        <h5>Language</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light" @onclick='() => Locale.SetCultureAsync("en")'>English</button>
            <button class="btn btn-outline-light" @onclick='() => Locale.SetCultureAsync("ur")'>اردو</button>
        </div>
    </div>

    <div class="cap-card">
        <h5>UI theme (local)</h5>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-light" @onclick='() => Theme.SetAsync("dark", "amber")'>Dark Amber</button>
            <button class="btn btn-outline-light" @onclick='() => Theme.SetAsync("dark", "cyan")'>Dark Cyan</button>
            <button class="btn btn-outline-light" @onclick='() => Theme.SetAsync("light", "emerald")'>Light Emerald</button>
            <button class="btn btn-outline-light" @onclick='() => Theme.SetAsync("light", "rose")'>Light Rose</button>
        </div>
    </div>
}

@code {
    private CompanySettingsDto? _settings;
    private AppConfigClientDto? _cfg;
    private bool _busy = true;
    private string? _error;
    private string _currentPassword = "";
    private string _newPassword = "";
    private bool _forcePassword;
    private bool _logoBusy;
    private bool _logoFromUpload;
    private string? _logoPreviewUrl;

    private string _selectedVertical = "auto-parts";
    private string _brandAppName = "", _brandShort = "", _brandAccentWord = "", _brandLogo = "", _brandTheme = "dark", _brandAccent = "amber";
    private string _currency = "PKR", _decimals = "2";
    private string _labelSearch = "", _labelCheckout = "", _labelNavPos = "";
    private readonly Dictionary<string, bool> _modules = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _behaviors = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, FieldConfigClientDto> _fields = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _moduleKeys = [];
    private List<string> _fieldKeys = [];
    private readonly string[] _behaviorBoolKeys = ["fbr.enabled", "tax.enabled", "pos.fitmentSearch", "pos.supersession"];

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _forcePassword = uri.Query.Contains("forcePassword=1", StringComparison.OrdinalIgnoreCase)
            || (await AuthState.GetUserAsync())?.MustChangePassword == true;

        if (!_forcePassword)
        {
            var (data, error, _) = await Api.GetSettingsAsync();
            _settings = data;
            _error = error;
            await AppConfig.RefreshFullAsync();
            LoadConfigEditor(AppConfig.Current);
            SyncLogoPreviewFromSettings();
        }
        _busy = false;
    }

    private void LoadConfigEditor(AppConfigClientDto? cfg)
    {
        _cfg = cfg;
        if (cfg is null) return;
        _selectedVertical = cfg.VerticalKey;
        _brandAppName = cfg.Branding.AppName;
        _brandShort = cfg.Branding.ShortName;
        _brandAccentWord = cfg.Branding.AccentWord;
        _brandLogo = cfg.Branding.LogoUrl ?? "";
        _brandTheme = cfg.Branding.Theme;
        _brandAccent = cfg.Branding.Accent;
        _logoFromUpload = IsUploadedLogoPath(_brandLogo);
        _modules.Clear();
        foreach (var kv in cfg.Modules) _modules[kv.Key] = kv.Value;
        _moduleKeys = _modules.Keys.OrderBy(k => k).ToList();
        _behaviors.Clear();
        foreach (var kv in cfg.Behaviors) _behaviors[kv.Key] = kv.Value;
        _currency = _behaviors.GetValueOrDefault("currency", "PKR");
        _decimals = _behaviors.GetValueOrDefault("decimals", "2");
        _fields.Clear();
        foreach (var kv in cfg.Fields)
            _fields[kv.Key] = new FieldConfigClientDto { Visible = kv.Value.Visible, Required = kv.Value.Required, Label = kv.Value.Label };
        _fieldKeys = _fields.Keys.OrderBy(k => k).ToList();
        if (cfg.Labels.TryGetValue("en", out var en))
        {
            _labelSearch = en.GetValueOrDefault("POS_SearchPlaceholder", "");
            _labelCheckout = en.GetValueOrDefault("POS_Checkout", "");
            _labelNavPos = en.GetValueOrDefault("Nav_POS", "");
        }
    }

    private void SyncLogoPreviewFromSettings()
    {
        var raw = _settings?.LogoUrl ?? _settings?.LogoPath ?? AppConfig.Branding.LogoUrl;
        _logoPreviewUrl = AppConfig.ResolvedLogoUrl;
        if (string.IsNullOrWhiteSpace(_logoPreviewUrl) && !string.IsNullOrWhiteSpace(raw))
        {
            if (raw.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                || raw.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                || raw.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
                _logoPreviewUrl = raw;
            else
                _logoPreviewUrl = AppConfig.ResolvedLogoUrl ?? raw;
        }
        _logoFromUpload = IsUploadedLogoPath(raw);
        if (!string.IsNullOrWhiteSpace(raw))
            _brandLogo = raw;
    }

    private static bool IsUploadedLogoPath(string? url) =>
        !string.IsNullOrWhiteSpace(url)
        && url.Contains("/uploads/company/", StringComparison.OrdinalIgnoreCase);

    private async Task SaveAsync()
    {
        if (_settings is null) return;
        var (ok, error, _) = await Api.UpdateSettingsAsync(_settings);
        if (!ok) Toast.ShowError(error ?? Locale["Toast_Error"]);
        else
        {
            Toast.ShowSuccess(Locale["Toast_Saved"]);
            await AppConfig.RefreshFullAsync();
            LoadConfigEditor(AppConfig.Current);
            SyncLogoPreviewFromSettings();
        }
    }

    private async Task OnLogoSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || _settings is null) return;
        if (file.Size > 2 * 1024 * 1024)
        {
            Toast.ShowError("Logo must be 2 MB or smaller.");
            return;
        }

        _logoBusy = true;
        try
        {
            await using var stream = file.OpenReadStream(2 * 1024 * 1024);
            var (logoUrl, error) = await Api.UploadLogoAsync(stream, file.Name);
            if (logoUrl is null)
            {
                Toast.ShowError(error ?? "Logo upload failed.");
                return;
            }

            _settings.LogoUrl = logoUrl;
            _settings.LogoPath = logoUrl;
            _brandLogo = logoUrl;
            _logoFromUpload = true;
            await AppConfig.RefreshFullAsync();
            LoadConfigEditor(AppConfig.Current);
            SyncLogoPreviewFromSettings();
            Toast.ShowSuccess("Logo uploaded");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _logoBusy = false;
        }
    }

    private async Task RemoveLogoAsync()
    {
        if (_settings is null) return;
        if (!await ConfirmAsync("Remove the shop logo?")) return;

        _logoBusy = true;
        try
        {
            var (ok, error, _) = await Api.DeleteLogoAsync();
            if (!ok)
            {
                Toast.ShowError(error ?? "Could not remove logo.");
                return;
            }

            _settings.LogoUrl = null;
            _settings.LogoPath = null;
            _brandLogo = "";
            _logoPreviewUrl = null;
            _logoFromUpload = false;
            await AppConfig.RefreshFullAsync();
            LoadConfigEditor(AppConfig.Current);
            Toast.ShowSuccess("Logo removed");
        }
        finally
        {
            _logoBusy = false;
        }
    }

    private async Task ApplyPresetAsync()
    {
        if (!await ConfirmAsync($"Reset all overrides and apply '{_selectedVertical}' defaults?")) return;
        var (data, error) = await AppConfig.UpdateAsync(new AppConfigUpdateClientRequest
        {
            VerticalKey = _selectedVertical,
            ApplyPresetDefaults = true
        });
        if (error is not null) { Toast.ShowError(error); return; }
        LoadConfigEditor(data);
        Toast.ShowSuccess("Preset applied");
    }

    private async Task SaveConfigAsync()
    {
        _behaviors["currency"] = _currency;
        _behaviors["decimals"] = _decimals;
        var labels = new Dictionary<string, Dictionary<string, string>>(StringComparer.OrdinalIgnoreCase)
        {
            ["en"] = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        };
        if (!string.IsNullOrWhiteSpace(_labelSearch)) labels["en"]["POS_SearchPlaceholder"] = _labelSearch;
        if (!string.IsNullOrWhiteSpace(_labelCheckout)) labels["en"]["POS_Checkout"] = _labelCheckout;
        if (!string.IsNullOrWhiteSpace(_labelNavPos)) labels["en"]["Nav_POS"] = _labelNavPos;

        var (data, error) = await AppConfig.UpdateAsync(new AppConfigUpdateClientRequest
        {
            VerticalKey = _selectedVertical,
            ApplyPresetDefaults = false,
            Modules = new Dictionary<string, bool>(_modules),
            Fields = new Dictionary<string, FieldConfigClientDto>(_fields),
            Behaviors = new Dictionary<string, string>(_behaviors),
            Brand = new Dictionary<string, string>
            {
                ["appName"] = _brandAppName,
                ["shortName"] = _brandShort,
                ["accentWord"] = _brandAccentWord,
                ["logoUrl"] = _brandLogo,
                ["theme"] = _brandTheme,
                ["accent"] = _brandAccent
            },
            Labels = labels
        });
        if (error is not null) { Toast.ShowError(error); return; }
        LoadConfigEditor(data);
        if (_settings is not null)
        {
            _settings.LogoUrl = string.IsNullOrWhiteSpace(_brandLogo) ? null : _brandLogo;
            _settings.LogoPath = _settings.LogoUrl;
        }
        SyncLogoPreviewFromSettings();
        Toast.ShowSuccess(Locale["Toast_Saved"]);
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        try
        {
            return await JS.InvokeAsync<bool>("confirm", message);
        }
        catch { return true; }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool IsBehaviorOn(string key) =>
        string.Equals(_behaviors.GetValueOrDefault(key), "true", StringComparison.OrdinalIgnoreCase);

    private void SetBehavior(string key, bool on) =>
        _behaviors[key] = on ? "true" : "false";

    private async Task ChangePasswordAsync()
    {
        var (ok, error, _) = await AuthApi.ChangePasswordAsync(_currentPassword, _newPassword);
        if (!ok) Toast.ShowError(error ?? Locale["Toast_Error"]);
        else
        {
            Toast.ShowSuccess(Locale["Toast_Saved"]);
            _currentPassword = _newPassword = "";
            _forcePassword = false;
            Nav.NavigateTo("/", true);
        }
    }
}
