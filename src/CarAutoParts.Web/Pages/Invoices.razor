@page "/invoices"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast
@inject NavigationManager Nav

<PageHeader Title="Sales Invoices" Subtitle="Wholesale & POS invoices — chain via Sales Orders" />
<div class="cap-card mb-3">
    <div class="row g-2">
        <div class="col-md-8"><input class="form-control" placeholder="Search invoice # or customer" @bind="_search" /></div>
        <div class="col-md-2"><button class="btn btn-cap w-100" @onclick="SearchAsync">Search</button></div>
        <div class="col-md-2"><a class="btn btn-outline-light w-100" href="sales-orders">Sales orders</a></div>
    </div>
</div>
<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Total</th><th>Payment</th><th>SLA</th><th>FBR</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var i in _items.Items)
            {
                <tr>
                    <td class="mono">@i.InvoiceNumber</td><td>@i.CustomerName</td>
                    <td>@i.InvoiceDate.ToLocalTime().ToString("g")</td><td>@i.GrandTotal.ToString("N2")</td>
                    <td>@i.PaymentStatus</td>
                    <td><span class="badge badge-soft">@(_slaBadges.GetValueOrDefault(i.Id, "—"))</span></td>
                    <td>@i.FbrInvoiceNumber</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => OpenAsync(i.Id)">Detail</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_items.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@if (_detail is not null)
{
    <div class="cap-card mt-3">
        <h5>@_detail.InvoiceNumber</h5>
        <p>@_detail.BuyerName — @_detail.GrandTotal.ToString("N2") (tax @_detail.TaxAmount.ToString("N2"))</p>
        <p class="small"><a href="sales-orders">View sales orders / document chain</a></p>
        <ul>@foreach (var l in _detail.Lines) { <li>@l.ProductName x @l.Quantity = @l.LineTotal.ToString("N2")</li> }</ul>
    </div>
}

@code {
    private PagedResult<SalesInvoiceListDto>? _items;
    private SalesInvoiceDetailDto? _detail;
    private bool _busy = true;
    private string? _error, _search;
    private int _page = 1;
    private int _pageSize = 10;
    private Dictionary<int, string> _slaBadges = new();

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery))
            _search = SearchQuery;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetInvoicesAsync(new QuerySpec { Search = _search, Page = _page, PageSize = _pageSize });
        _items = data; _error = error;
        var (alerts, _, _) = await Api.GetSlaAlertsAsync(2);
        _slaBadges = (alerts ?? []).ToDictionary(a => a.EntityId, a => a.IsBreached ? "Breached" : a.IsWarned ? "Warning" : "—");
        _busy = false;
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }

    private async Task OpenAsync(int id)
    {
        var (data, error, _) = await Api.GetInvoiceAsync(id);
        if (error is not null) Toast.ShowError(error);
        _detail = data;
    }
}
