@page "/ap-invoices"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="AP Invoices" Subtitle="Create, three-way match, post" />
<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive mb-3">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Number</th><th>Supplier</th><th>Status</th><th>Matched</th><th>SLA</th><th>Total</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var i in _items.Items)
            {
                <tr>
                    <td class="mono">@i.InvoiceNumber</td>
                    <td>@i.SupplierId</td>
                    <td>@i.Status</td>
                    <td>@(i.ThreeWayMatched ? "Yes" : "No")</td>
                    <td><span class="badge badge-soft">@(_slaBadges.GetValueOrDefault(i.Id, "—"))</span></td>
                    <td>@i.GrandTotal.ToString("N2")</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => MatchAsync(i.Id)">Match</button>
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => PostAsync(i.Id)">Post</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_items.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@if (_match is not null)
{
    <div class="cap-card mb-3">
        <h5>Match result — @_match.Summary</h5>
        <p>Fully matched: @(_match.IsFullyMatched ? "Yes" : "No")</p>
    </div>
}

<div class="cap-card mb-3">
    <h5>New AP invoice</h5>
    <div class="row g-2">
        <div class="col-md-2">
            <select class="form-select" @bind="_create.SupplierId">
                <option value="0">Supplier…</option>
                @foreach (var s in _suppliers) { <option value="@s.Id">@s.Name</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="_grnId">
                <option value="">GRN (opt)…</option>
                @foreach (var g in _grns) { <option value="@g.Id">@g.GrnNumber</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="_line.ProductId">
                <option value="0">Product…</option>
                @foreach (var p in _products) { <option value="@p.Id">@p.Name (@p.Sku)</option> }
            </select>
        </div>
        <div class="col-md-2"><input type="number" class="form-control" placeholder="Qty" @bind="_line.Quantity" /></div>
        <div class="col-md-2"><input type="number" class="form-control" placeholder="Cost" @bind="_line.UnitCost" /></div>
        <div class="col-md-2"><button class="btn btn-cap w-100" @onclick="CreateAsync">Create</button></div>
    </div>
</div>

@code {
    private PagedResult<PurchaseInvoiceDto>? _items;
    private ThreeWayMatchResultDto? _match;
    private CreatePurchaseInvoiceRequest _create = new() { InvoiceDate = DateTime.UtcNow };
    private CreatePurchaseInvoiceLineRequest _line = new() { Quantity = 1 };
    private int? _grnId;
    private bool _busy = true;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 10;
    private Dictionary<int, string> _slaBadges = new();
    private List<SupplierDto> _suppliers = [];
    private List<ProductListDto> _products = [];
    private List<GoodsReceiptNoteDto> _grns = [];

    protected override async Task OnInitializedAsync()
    {
        var (sup, _, _) = await Api.GetSuppliersAsync(new QuerySpec { Page = 1, PageSize = 200 });
        _suppliers = sup?.Items ?? [];
        var (prod, _, _) = await Api.GetProductsAsync(new QuerySpec { Page = 1, PageSize = 200 });
        _products = prod?.Items ?? [];
        var (grn, _, _) = await Api.GetGrnsAsync(new QuerySpec { Page = 1, PageSize = 100 });
        _grns = grn?.Items ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetApInvoicesAsync(new QuerySpec { Page = _page, PageSize = _pageSize });
        _items = data; _error = error;
        var (alerts, _, _) = await Api.GetSlaAlertsAsync(4);
        _slaBadges = (alerts ?? []).ToDictionary(a => a.EntityId, a => a.IsBreached ? "Breached" : a.IsWarned ? "Warning" : "—");
        _busy = false;
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }

    private async Task CreateAsync()
    {
        _create.GoodsReceiptNoteId = _grnId;
        _create.Lines = [_line];
        var (_, error, _) = await Api.CreateApInvoiceAsync(_create);
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess("AP invoice created"); await LoadAsync(); }
    }

    private async Task MatchAsync(int id)
    {
        var (data, error, _) = await Api.MatchApInvoiceAsync(id);
        if (error is not null) Toast.ShowError(error);
        else { _match = data; Toast.ShowSuccess("Match complete"); await LoadAsync(); }
    }

    private async Task PostAsync(int id)
    {
        var (_, error, _) = await Api.PostApInvoiceAsync(id);
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess("AP invoice posted"); await LoadAsync(); }
    }
}
