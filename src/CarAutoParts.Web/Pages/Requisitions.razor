@page "/requisitions"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="Purchase Requisitions" Subtitle="Draft → Submit → Approve → Convert to PO" />
<LoadingState Busy="@_busy" Error="@_error" />

@if (_items is not null)
{
    <div class="cap-card table-responsive mb-3">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>Number</th><th>Supplier</th><th>Status</th><th>Requested</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var r in _items.Items)
            {
                <tr>
                    <td class="mono">@r.RequisitionNumber</td>
                    <td>@(r.SupplierName ?? r.SupplierId?.ToString() ?? "—")</td>
                    <td>@StatusName(r.Status)</td>
                    <td>@r.RequestedAt.ToLocalTime().ToString("g")</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            @if (r.Status == 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SubmitAsync(r.Id)">Submit</button>
                            }
                            @if (r.Status == 1)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => ApproveAsync(r.Id)">Approve</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RejectAsync(r.Id)">Reject</button>
                            }
                            @if (r.Status == 2)
                            {
                                <button type="button" class="btn btn-sm btn-cap" @onclick="() => ConvertAsync(r.Id)">Convert to PO</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <Pager Page="_page" PageSize="_pageSize" TotalCount="_items.TotalCount" Disabled="_busy"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    </div>
}

<div class="cap-card mb-3">
    <h5>New requisition</h5>
    <div class="row g-2">
        <div class="col-md-2"><input type="number" class="form-control" placeholder="SupplierId" @bind="_create.SupplierId" /></div>
        <div class="col-md-2"><input type="number" class="form-control" placeholder="WarehouseId" @bind="_create.WarehouseId" /></div>
        <div class="col-md-2"><input type="number" class="form-control" placeholder="ProductId" @bind="_line.ProductId" /></div>
        <div class="col-md-2"><input type="number" class="form-control" placeholder="Qty" @bind="_line.Quantity" /></div>
        <div class="col-md-2"><input type="number" class="form-control" placeholder="Unit price" @bind="_line.SuggestedUnitPrice" /></div>
        <div class="col-md-2"><button class="btn btn-cap w-100" @onclick="CreateAsync">Create draft</button></div>
    </div>
</div>

@code {
    private PagedResult<PurchaseRequisitionDto>? _items;
    private PurchaseRequisitionCreateDto _create = new();
    private PurchaseRequisitionLineCreateDto _line = new() { Quantity = 1 };
    private bool _busy = true;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 10;

    private static string StatusName(int s) => s switch
    {
        0 => "Draft",
        1 => "Submitted",
        2 => "Approved",
        3 => "Rejected",
        4 => "Converted",
        _ => s.ToString()
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetRequisitionsAsync(new QuerySpec { Page = _page, PageSize = _pageSize });
        _items = data; _error = error; _busy = false;
    }

    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }
    private async Task OnPageSizeChanged(int size) { _pageSize = size; _page = 1; await LoadAsync(); }

    private async Task CreateAsync()
    {
        _create.Lines = [_line];
        var (_, error, _) = await Api.CreateRequisitionAsync(_create);
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess("Draft PR created"); await LoadAsync(); }
    }

    private async Task SubmitAsync(int id)
    {
        var (_, error, _) = await Api.SubmitRequisitionAsync(id);
        if (error is not null) Toast.ShowError(error); else { Toast.ShowSuccess("Submitted"); await LoadAsync(); }
    }

    private async Task ApproveAsync(int id)
    {
        var (_, error, _) = await Api.ApproveRequisitionAsync(id);
        if (error is not null) Toast.ShowError(error); else { Toast.ShowSuccess("Approved"); await LoadAsync(); }
    }

    private async Task RejectAsync(int id)
    {
        var (_, error, _) = await Api.RejectRequisitionAsync(id, "Rejected from UI");
        if (error is not null) Toast.ShowError(error); else { Toast.ShowSuccess("Rejected"); await LoadAsync(); }
    }

    private async Task ConvertAsync(int id)
    {
        var (po, error, _) = await Api.ConvertRequisitionToPoAsync(id);
        if (error is not null) Toast.ShowError(error);
        else { Toast.ShowSuccess($"Converted to {po?.OrderNumber}"); await LoadAsync(); }
    }
}
