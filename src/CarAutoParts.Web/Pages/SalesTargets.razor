@page "/sales-targets"
@attribute [Authorize]
@inject CapApiService Api
@inject IToastService Toast

<PageHeader Title="Sales targets" Subtitle="Monthly target amount per salesperson" />
<LoadingState Busy="@_busy" Error="@_error" />

<div class="cap-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small mb-0">Year filter</label>
            <input type="number" class="form-control" @bind="_filterYear" />
        </div>
        <div class="col-md-3"><button class="btn btn-outline-light w-100" @onclick="LoadAsync">Filter</button></div>
    </div>
</div>

@if (_items is not null)
{
    <div class="cap-card table-responsive mb-3">
        <table class="table table-cap table-striped mb-0">
            <thead><tr><th>User</th><th>Year</th><th>Month</th><th>Target</th><th>Actual</th><th>Attain %</th><th>Notes</th><th class="cap-col-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var t in _items)
            {
                <tr>
                    <td>@(t.UserName ?? t.UserId.ToString())</td>
                    <td>@t.PeriodYear</td>
                    <td>@t.PeriodMonth</td>
                    <td>@t.TargetAmount.ToString("N2")</td>
                    <td>@t.ActualAmount.ToString("N2")</td>
                    <td>@t.AttainmentPercent.ToString("N1")%</td>
                    <td>@t.Notes</td>
                    <td class="cap-col-actions">
                        <div class="cap-actions">
                            <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => BeginEdit(t)">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(t.Id)">Del</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="cap-card">
    <h5>@(_editId is null ? "New target" : "Edit target")</h5>
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small mb-0">User</label>
            <select class="form-select" @bind="_form.UserId">
                <option value="0">Select…</option>
                @foreach (var u in _users)
                {
                    <option value="@u.Id">@u.Username</option>
                }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label small mb-0">Year</label><input type="number" class="form-control" @bind="_form.PeriodYear" /></div>
        <div class="col-md-2"><label class="form-label small mb-0">Month</label><input type="number" min="1" max="12" class="form-control" @bind="_form.PeriodMonth" /></div>
        <div class="col-md-2"><label class="form-label small mb-0">Target amount</label><input type="number" step="0.01" class="form-control" @bind="_form.TargetAmount" /></div>
        <div class="col-md-3"><label class="form-label small mb-0">Notes</label><input class="form-control" @bind="_form.Notes" /></div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-cap" @onclick="SaveAsync">Save</button>
        @if (_editId is not null)
        {
            <button class="btn btn-outline-light" @onclick="ResetForm">Cancel</button>
        }
    </div>
</div>

@code {
    private List<SalesTargetDto>? _items;
    private List<UserDto> _users = [];
    private SalesTargetUpsertRequest _form = new();
    private int? _editId;
    private int? _filterYear = DateTime.Today.Year;
    private bool _busy = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var (users, _, _) = await Api.GetUsersAsync();
        _users = users ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        var (data, error, _) = await Api.GetSalesTargetsAsync(year: _filterYear);
        _items = data; _error = error; _busy = false;
    }

    private void BeginEdit(SalesTargetDto t)
    {
        _editId = t.Id;
        _form = new SalesTargetUpsertRequest
        {
            UserId = t.UserId,
            PeriodYear = t.PeriodYear,
            PeriodMonth = t.PeriodMonth,
            TargetAmount = t.TargetAmount,
            Notes = t.Notes
        };
    }

    private void ResetForm()
    {
        _editId = null;
        _form = new SalesTargetUpsertRequest();
    }

    private async Task SaveAsync()
    {
        if (_form.UserId == 0) { Toast.ShowError("Select a user"); return; }

        if (_editId is int id)
        {
            var (_, error, _) = await Api.UpdateSalesTargetAsync(id, _form);
            if (error is not null) { Toast.ShowError(error); return; }
            Toast.ShowSuccess("Target updated");
        }
        else
        {
            var (_, error, _) = await Api.CreateSalesTargetAsync(_form);
            if (error is not null) { Toast.ShowError(error); return; }
            Toast.ShowSuccess("Target created");
        }

        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var (ok, error, _) = await Api.DeleteSalesTargetAsync(id);
        if (!ok) Toast.ShowError(error ?? "Failed"); else await LoadAsync();
    }
}
