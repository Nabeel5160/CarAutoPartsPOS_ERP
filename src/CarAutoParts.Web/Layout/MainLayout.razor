@using CarAutoParts.Web.Navigation
@inherits LayoutComponentBase
@inject ThemeService Theme
@inject LocaleService Locale
@inject PermissionService Perms
@inject AuthApiService AuthApi
@inject CapApiService Api
@inject OfflineCheckoutQueue OfflineQueue
@inject WebAppConfigService AppConfig
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthState
@implements IDisposable

<div class="cap-scene">
    <BlazoredToasts Position="Blazored.Toast.Configuration.ToastPosition.BottomRight" Timeout="4" />
    @if (ApiReachability.IsDown)
    {
        <div class="alert alert-cap border-danger text-danger cap-banner-offline">API unreachable — @ApiReachability.LastError</div>
    }
    <AuthorizeView>
        <Authorized>
            <div class="cap-shell @(_sidebarOpen ? "cap-nav-open" : null)">
                @if (_sidebarOpen)
                {
                    <button type="button" class="cap-nav-backdrop d-lg-none" aria-label="Close menu" @onclick="CloseSidebar"></button>
                }
                <aside class="cap-sidebar @(_sidebarOpen ? "open" : null)">
                    <div class="cap-brand">@AppConfig.Branding.ShortName <span>@AppConfig.Branding.AccentWord</span></div>
                    <nav class="cap-nav" @onclick="OnNavClick">
                        @foreach (var group in _groups.Where(g => g.Visible))
                        {
                            @if (group.IsLeaf)
                            {
                                var leaf = group.Children[0];
                                <NavLink href="@leaf.Href" Match="@(leaf.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="cap-nav-link">
                                    <span class="cap-nav-ico">@leaf.Icon</span>
                                    <span>@leaf.Title</span>
                                </NavLink>
                            }
                            else
                            {
                                var open = _expanded.Contains(group.Id);
                                <div class="cap-nav-group @(open ? "open" : null) @(IsGroupActive(group) ? "has-active" : null)">
                                    <button type="button" class="cap-nav-parent" @onclick="() => ToggleGroup(group.Id)" @onclick:stopPropagation="true" aria-expanded="@open">
                                        <span class="cap-nav-ico">@group.Icon</span>
                                        <span class="cap-nav-parent-label">@group.Title</span>
                                        <span class="cap-nav-chevron" aria-hidden="true">▾</span>
                                    </button>
                                    <div class="cap-nav-children" aria-hidden="@(!open)">
                                        <div class="cap-nav-children-inner">
                                            @foreach (var child in group.Children.Where(c => c.Visible))
                                            {
                                                <NavLink href="@child.Href" Match="@(child.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="cap-nav-link cap-nav-child" tabindex="@(open ? 0 : -1)">
                                                    <span class="cap-nav-ico">@child.Icon</span>
                                                    <span>@child.Title</span>
                                                </NavLink>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </nav>
                </aside>
                <div class="cap-main">
                    <header class="cap-topbar">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <button type="button" class="btn btn-sm btn-cap-ghost d-lg-none cap-touch-btn" @onclick="() => _sidebarOpen = !_sidebarOpen">Menu</button>
                            <span class="badge badge-soft text-truncate">@_displayName</span>
                            @if (OfflineQueue.PendingCount > 0)
                            {
                                <a class="badge text-bg-warning text-decoration-none" href="pos" title="Offline checkout queue">
                                    Queue @OfflineQueue.PendingCount
                                </a>
                            }
                            @if (_unread > 0)
                            {
                                <a class="badge text-bg-warning text-decoration-none" href="notifications">@_unread new</a>
                            }
                            <a class="badge badge-soft text-decoration-none d-lg-none" href="m" title="Mobile tools">Mobile</a>
                        </div>
                        <div class="d-flex align-items-center gap-2 cap-topbar-tools">
                            <select class="form-select form-select-sm cap-topbar-dense" style="width:auto" value="@Locale.Culture" @onchange="OnCultureChanged">
                                <option value="en">EN</option>
                                <option value="ur">UR</option>
                            </select>
                            <select class="form-select form-select-sm cap-topbar-dense" style="width:auto" value="@Theme.Mode" @onchange="OnModeChanged">
                                <option value="dark">Dark</option>
                                <option value="light">Light</option>
                            </select>
                            <select class="form-select form-select-sm cap-topbar-dense d-none d-sm-block" style="width:auto" value="@Theme.Accent" @onchange="OnAccentChanged">
                                <option value="amber">Amber</option>
                                <option value="cyan">Cyan</option>
                                <option value="emerald">Emerald</option>
                                <option value="rose">Rose</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-cap-outline cap-touch-btn" @onclick="LogoutAsync">Logout</button>
                        </div>
                    </header>
                    <main class="cap-content">
                        @Body
                    </main>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _sidebarOpen;
    private string _displayName = "User";
    private int _unread;
    private List<NavGroup> _groups = [];
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private readonly SemaphoreSlim _navBuildLock = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        ApiReachability.Changed += OnApiReachabilityChanged;
        OfflineQueue.Changed += OnOfflineQueueChanged;
        Theme.Changed += OnThemeChanged;
        Nav.LocationChanged += OnLocationChanged;
        try
        {
            await Theme.InitializeAsync();
            await Locale.InitializeAsync();
            await AppConfig.RefreshFullAsync();
            // Branding refresh must not leave company theme on the DOM — restore user preference.
            await Theme.ReapplyAsync();
            await EnforcePasswordChangeAsync();
            await EnforceOnboardingAsync();
            await EnforceModuleRouteAsync();
            // Build once after refresh, then subscribe — RefreshFullAsync fires AppConfig/Locale
            // Changed (via ApplyLocaleOverrides), which would otherwise race BuildNavAsync.
            await BuildNavAsync();
            Locale.Changed += OnLocaleChanged;
            AppConfig.Changed += OnAppConfigChanged;
            _displayName = await Perms.DisplayNameAsync();
            var (count, _, status) = await Api.GetUnreadCountAsync();
            if (status == 200 && count is not null) _unread = count.Count;
            await OfflineQueue.RefreshCountAsync();
        }
        catch (Exception ex)
        {
            // Keep shell usable after login even if one init call fails (nav/notifications/offline).
            System.Diagnostics.Debug.WriteLine("MainLayout init: " + ex);
            Locale.Changed += OnLocaleChanged;
            AppConfig.Changed += OnAppConfigChanged;
            try { await BuildNavAsync(); } catch { /* ignore */ }
        }
    }

    private void OnAppConfigChanged() => InvokeAsync(async () =>
    {
        await Theme.ReapplyAsync();
        await BuildNavAsync();
        StateHasChanged();
    });

    private Task EnforceModuleRouteAsync()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        var module = NavDefinition.ModuleForRoute(relative);
        if (module is not null && !AppConfig.ModuleEnabled(module))
            Nav.NavigateTo("/");
        return Task.CompletedTask;
    }

    private void OnOfflineQueueChanged() => InvokeAsync(StateHasChanged);

    private void OnApiReachabilityChanged()
    {
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            if (!ApiReachability.IsDown && OfflineQueue.PendingCount > 0)
            {
                await OfflineQueue.DrainAsync(async payload =>
                {
                    var (data, error, _) = await Api.CheckoutRawAsync(payload);
                    return (data is not null, error);
                });
            }
        });
    }

    private async Task EnforcePasswordChangeAsync()
    {
        var user = await AuthState.GetUserAsync();
        if (user?.MustChangePassword != true) return;
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (relative.StartsWith("settings", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("login", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("onboarding", StringComparison.OrdinalIgnoreCase))
            return;
        Nav.NavigateTo("/settings?forcePassword=1");
    }

    private async Task EnforceOnboardingAsync()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (relative.StartsWith("onboarding", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("login", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("settings", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("mfa-setup", StringComparison.OrdinalIgnoreCase))
            return;

        var (status, _, code) = await Api.GetOnboardingStatusAsync();
        if (code != 200 || status is null || status.IsComplete) return;
        Nav.NavigateTo("/onboarding");
    }

    private async Task BuildNavAsync()
    {
        await _navBuildLock.WaitAsync();
        try
        {
            async Task<bool> Can(string? p) => p is null || await Perms.HasAsync(p);

            string Title(NavDefItem item) =>
                item.TitleIsLocaleKey ? Locale[item.TitleKeyOrLiteral] : item.TitleKeyOrLiteral;

            string GroupTitle(NavDefGroup g) =>
                g.TitleIsLocaleKey ? Locale[g.TitleKeyOrLiteral] : g.TitleKeyOrLiteral;

            var built = new List<NavGroup>();
            foreach (var def in NavDefinition.Groups)
            {
                var children = new List<NavItem>();
                foreach (var item in def.Children)
                {
                    var visible = await Can(item.Permission) &&
                                  (item.ModuleKey is null || AppConfig.ModuleEnabled(item.ModuleKey));
                    children.Add(new NavItem(Title(item), item.Href, item.Icon, visible, item.Exact));
                }

                var groupVisible = children.Any(c => c.Visible);
                built.Add(new NavGroup(def.Id, GroupTitle(def), def.Icon, groupVisible, children, def.Leaf));
            }

            _groups = built;
            ExpandActiveGroups();
        }
        finally
        {
            _navBuildLock.Release();
        }
    }

    private void ToggleGroup(string id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private bool IsGroupActive(NavGroup group)
    {
        var relative = CurrentRelative();
        return group.Children.Any(c => c.Visible && PathMatches(relative, c.Href, c.Exact));
    }

    private void ExpandActiveGroups()
    {
        foreach (var g in _groups.Where(g => !g.IsLeaf && IsGroupActive(g)))
            _expanded.Add(g.Id);
    }

    /// <summary>Base-relative path including query (no leading slash), for query-aware nav matching.</summary>
    private string CurrentRelative()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri);
        var hash = uri.IndexOf('#', StringComparison.Ordinal);
        if (hash >= 0) uri = uri[..hash];
        return uri.TrimStart('/');
    }

    private static bool PathMatches(string relativeWithQuery, string href, bool exact)
    {
        href = (href ?? "").TrimStart('/');
        var path = relativeWithQuery.Split('?', 2)[0].TrimEnd('/');
        var hrefParts = href.Split('?', 2);
        var hrefPath = hrefParts[0].TrimEnd('/');
        var hrefQuery = hrefParts.Length > 1 ? hrefParts[1] : null;
        var uriQuery = relativeWithQuery.Contains('?', StringComparison.Ordinal)
            ? relativeWithQuery[(relativeWithQuery.IndexOf('?', StringComparison.Ordinal) + 1)..]
            : null;

        if (!string.IsNullOrEmpty(hrefQuery))
        {
            if (!path.Equals(hrefPath, StringComparison.OrdinalIgnoreCase)) return false;
            return QueryContainsAll(uriQuery, hrefQuery);
        }

        if (exact) return string.Equals(path, hrefPath, StringComparison.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(hrefPath)) return string.IsNullOrEmpty(path);
        return path.Equals(hrefPath, StringComparison.OrdinalIgnoreCase)
               || path.StartsWith(hrefPath + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static bool QueryContainsAll(string? uriQuery, string requiredQuery)
    {
        if (string.IsNullOrEmpty(uriQuery)) return false;
        var uriPairs = ParseQuery(uriQuery);
        foreach (var (key, value) in ParseQuery(requiredQuery))
        {
            if (!uriPairs.TryGetValue(key, out var actual) ||
                !string.Equals(actual, value, StringComparison.OrdinalIgnoreCase))
                return false;
        }
        return true;
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0) result[part] = "";
            else result[part[..eq]] = part[(eq + 1)..];
        }
        return result;
    }

    private void CloseSidebar() => _sidebarOpen = false;

    private void OnNavClick()
    {
        // Close drawer after tapping a link (group toggles stop propagation).
        if (_sidebarOpen) _sidebarOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _sidebarOpen = false;
        _ = EnforcePasswordChangeAsync();
        _ = EnforceOnboardingAsync();
        _ = EnforceModuleRouteAsync();
        ExpandActiveGroups();
        InvokeAsync(StateHasChanged);
    }

    private async Task OnModeChanged(ChangeEventArgs e)
    {
        await Theme.SetAsync(e.Value?.ToString() ?? "dark", Theme.Accent);
    }

    private async Task OnAccentChanged(ChangeEventArgs e)
    {
        await Theme.SetAsync(Theme.Mode, e.Value?.ToString() ?? "amber");
    }

    private async Task OnCultureChanged(ChangeEventArgs e)
    {
        await Locale.SetCultureAsync(e.Value?.ToString() ?? "en");
        await BuildNavAsync();
    }

    private async Task LogoutAsync()
    {
        await AuthApi.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    private void OnLocaleChanged() => InvokeAsync(async () => { await BuildNavAsync(); StateHasChanged(); });

    public void Dispose()
    {
        ApiReachability.Changed -= OnApiReachabilityChanged;
        OfflineQueue.Changed -= OnOfflineQueueChanged;
        Theme.Changed -= OnThemeChanged;
        Locale.Changed -= OnLocaleChanged;
        AppConfig.Changed -= OnAppConfigChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _navBuildLock.Dispose();
    }

    private sealed record NavItem(string Title, string Href, string Icon, bool Visible, bool Exact);

    private sealed class NavGroup
    {
        public NavGroup(string id, string title, string icon, bool visible, List<NavItem> children, bool leaf = false)
        {
            Id = id;
            Title = title;
            Icon = icon;
            Visible = visible;
            Children = children.Where(c => c.Visible).ToList();
            IsLeaf = leaf;
        }

        public string Id { get; }
        public string Title { get; }
        public string Icon { get; }
        public bool Visible { get; set; }
        public List<NavItem> Children { get; }
        public bool IsLeaf { get; }
    }
}
