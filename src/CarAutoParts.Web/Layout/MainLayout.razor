@inherits LayoutComponentBase
@inject ThemeService Theme
@inject LocaleService Locale
@inject PermissionService Perms
@inject AuthApiService AuthApi
@inject CapApiService Api
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthState
@implements IDisposable

<div class="cap-scene">
    <BlazoredToasts Position="Blazored.Toast.Configuration.ToastPosition.BottomRight" Timeout="4" />
    @if (ApiReachability.IsDown)
    {
        <div class="alert alert-danger mb-0 rounded-0 text-center py-2">API unreachable — @ApiReachability.LastError</div>
    }
    <AuthorizeView>
        <Authorized>
            <div class="cap-shell">
                <aside class="cap-sidebar @(_sidebarOpen ? "open" : null)">
                    <div class="cap-brand">Car Auto <span>Parts</span></div>
                    <nav class="cap-nav">
                        @foreach (var group in _groups.Where(g => g.Visible))
                        {
                            @if (group.IsLeaf)
                            {
                                var leaf = group.Children[0];
                                <NavLink href="@leaf.Href" Match="@(leaf.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="cap-nav-link">
                                    <span class="cap-nav-ico">@leaf.Icon</span>
                                    <span>@leaf.Title</span>
                                </NavLink>
                            }
                            else
                            {
                                var open = _expanded.Contains(group.Id);
                                <div class="cap-nav-group @(open ? "open" : null) @(IsGroupActive(group) ? "has-active" : null)">
                                    <button type="button" class="cap-nav-parent" @onclick="() => ToggleGroup(group.Id)" aria-expanded="@open">
                                        <span class="cap-nav-ico">@group.Icon</span>
                                        <span class="cap-nav-parent-label">@group.Title</span>
                                        <span class="cap-nav-chevron" aria-hidden="true">▾</span>
                                    </button>
                                    <div class="cap-nav-children" aria-hidden="@(!open)">
                                        <div class="cap-nav-children-inner">
                                            @foreach (var child in group.Children.Where(c => c.Visible))
                                            {
                                                <NavLink href="@child.Href" Match="@(child.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="cap-nav-link cap-nav-child" tabindex="@(open ? 0 : -1)">
                                                    <span class="cap-nav-ico">@child.Icon</span>
                                                    <span>@child.Title</span>
                                                </NavLink>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </nav>
                </aside>
                <div class="cap-main">
                    <header class="cap-topbar">
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-light d-lg-none" @onclick="() => _sidebarOpen = !_sidebarOpen">Menu</button>
                            <span class="badge badge-soft">@_displayName</span>
                            @if (_unread > 0)
                            {
                                <a class="badge text-bg-warning text-decoration-none" href="notifications">@_unread new</a>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm" style="width:auto" value="@Locale.Culture" @onchange="OnCultureChanged">
                                <option value="en">EN</option>
                                <option value="ur">UR</option>
                            </select>
                            <select class="form-select form-select-sm" style="width:auto" value="@Theme.Mode" @onchange="OnModeChanged">
                                <option value="dark">Dark</option>
                                <option value="light">Light</option>
                            </select>
                            <select class="form-select form-select-sm" style="width:auto" value="@Theme.Accent" @onchange="OnAccentChanged">
                                <option value="amber">Amber</option>
                                <option value="cyan">Cyan</option>
                                <option value="emerald">Emerald</option>
                                <option value="rose">Rose</option>
                            </select>
                            <button class="btn btn-sm btn-outline-warning" @onclick="LogoutAsync">Logout</button>
                        </div>
                    </header>
                    <main class="cap-content">
                        @Body
                    </main>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _sidebarOpen;
    private string _displayName = "User";
    private int _unread;
    private List<NavGroup> _groups = [];
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        ApiReachability.Changed += OnApiReachabilityChanged;
        Theme.Changed += OnThemeChanged;
        Locale.Changed += OnLocaleChanged;
        Nav.LocationChanged += OnLocationChanged;
        await Theme.InitializeAsync();
        await Locale.InitializeAsync();
        await EnforcePasswordChangeAsync();
        await BuildNavAsync();
        _displayName = await Perms.DisplayNameAsync();
        var (count, _, status) = await Api.GetUnreadCountAsync();
        if (status == 200 && count is not null) _unread = count.Count;
    }

    private async Task EnforcePasswordChangeAsync()
    {
        var user = await AuthState.GetUserAsync();
        if (user?.MustChangePassword != true) return;
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (relative.StartsWith("settings", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("login", StringComparison.OrdinalIgnoreCase))
            return;
        Nav.NavigateTo("/settings?forcePassword=1");
    }

    private async Task BuildNavAsync()
    {
        async Task<bool> Can(string? p) => p is null || await Perms.HasAsync(p);

        async Task<NavItem> Item(string title, string href, string icon, string? perm, bool exact = false) =>
            new(title, href, icon, await Can(perm), exact);

        var dashboard = await Item(Locale["Nav_Dashboard"], "", "◉", Permissions.DashboardView, true);

        _groups =
        [
            new NavGroup("dash", Locale["Nav_Dashboard"], "◉", true, [dashboard], leaf: true),
            new NavGroup("catalog", "Catalog", "▣", true,
            [
                await Item("Products", "products", "▣", Permissions.ProductsView),
                await Item("Categories", "categories", "▦", Permissions.CategoriesView),
                await Item("Brands", "brands", "◈", Permissions.BrandsView),
                await Item("Kits", "kits", "🧩", Permissions.KitsManage),
                await Item("Price Lists", "price-lists", "💲", Permissions.PriceListsManage),
                await Item("Barcodes", "barcodes", "║", Permissions.ProductsView),
            ]),
            new NavGroup("inventory", "Inventory", "▤", true,
            [
                await Item("Stock", "inventory", "▤", Permissions.InventoryView),
                await Item("Warehouses", "warehouses", "⌂", Permissions.WarehousesView),
                await Item("Movements", "movements", "⇄", Permissions.InventoryView),
                await Item("Serials", "serials", "#", Permissions.SerialNumbersView),
                await Item("Reservations", "reservations", "⏳", Permissions.InventoryAdjust),
                await Item("Cycle Counts", "cycle-counts", "🔢", Permissions.CycleCountManage),
                await Item("Transfers", "transfers", "↔", Permissions.TransfersView),
            ]),
            new NavGroup("partners", "Partners", "◎", true,
            [
                await Item("Suppliers", "suppliers", "🚚", Permissions.SuppliersView),
                await Item("Customers", "customers", "◎", Permissions.CustomersView),
                await Item("Aging", "partner-aging", "⏰", Permissions.FinanceView),
                await Item("Receipts", "receipts", "💰", Permissions.FinanceView),
            ]),
            new NavGroup("purchasing", "Purchasing", "↓", true,
            [
                await Item("Purchase Orders", "purchases", "↓", Permissions.PurchasesView),
                await Item("Requisitions", "requisitions", "☰", Permissions.PurchasesRequisition),
                await Item("Reorder", "reorder", "↻", Permissions.PurchasesRequisition),
                await Item("GRN", "grn", "📥", Permissions.GrnManage),
                await Item("AP Invoices", "ap-invoices", "📄", Permissions.ApInvoiceManage),
            ]),
            new NavGroup("sales", "Sales", "💳", true,
            [
                await Item(Locale["Nav_POS"], "pos", "💳", Permissions.PosCheckout),
                await Item("Quotations", "quotations", "✎", Permissions.QuotationsManage),
                await Item("Sales Orders", "sales-orders", "≡", Permissions.SalesView),
                await Item("Deliveries", "deliveries", "🚛", Permissions.DeliveriesManage),
                await Item("Invoices", "invoices", "🧾", Permissions.SalesView),
                await Item("Returns", "returns", "↩", Permissions.ReturnsManage),
                await Item("FBR", "fbr", "☁", Permissions.PosCheckout),
            ]),
            new NavGroup("finance", "Finance", "📒", true,
            [
                await Item("Company", "company", "🏢", Permissions.PlatformView),
                await Item("COA", "coa", "📒", Permissions.FinanceView),
                await Item(Locale["Finance_Journals"], "journals", "☰", Permissions.FinanceView),
                await Item("Periods", "periods", "📅", Permissions.FinancePost),
                await Item("Fin Reports", "financial-reports", "Σ", Permissions.FinanceView),
                await Item("Mappings", "account-mappings", "🔗", Permissions.FinanceView),
            ]),
            new NavGroup("insights", "Insights", "📈", true,
            [
                await Item("Reports", "reports", "▤", Permissions.ReportsExport),
                await Item("Analytics", "analytics", "📈", Permissions.AnalyticsView),
            ]),
            new NavGroup("system", "System", "⚙", true,
            [
                await Item("Users", "users", "☺", Permissions.UsersView),
                await Item("Audit", "audit", "⏱", Permissions.AuditView),
                await Item("Settings", "settings", "⚙", Permissions.SettingsView),
                await Item("Backup", "backup", "💾", Permissions.BackupView),
                await Item("Notifications", "notifications", "🔔", null),
            ]),
        ];

        // Hide empty groups (all children filtered by permission)
        foreach (var g in _groups)
        {
            if (!g.IsLeaf)
                g.Visible = g.Children.Any(c => c.Visible);
        }

        ExpandActiveGroups();
    }

    private void ToggleGroup(string id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private bool IsGroupActive(NavGroup group)
    {
        var path = CurrentPath();
        return group.Children.Any(c => c.Visible && PathMatches(path, c.Href, c.Exact));
    }

    private void ExpandActiveGroups()
    {
        foreach (var g in _groups.Where(g => !g.IsLeaf && IsGroupActive(g)))
            _expanded.Add(g.Id);
    }

    private string CurrentPath()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri);
        var q = uri.IndexOf('?', StringComparison.Ordinal);
        if (q >= 0) uri = uri[..q];
        return uri.Trim('/');
    }

    private static bool PathMatches(string path, string href, bool exact)
    {
        href = (href ?? "").Trim('/');
        if (exact) return string.Equals(path, href, StringComparison.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(href)) return string.IsNullOrEmpty(path);
        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
               || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = EnforcePasswordChangeAsync();
        ExpandActiveGroups();
        InvokeAsync(StateHasChanged);
    }

    private async Task OnModeChanged(ChangeEventArgs e)
    {
        await Theme.SetAsync(e.Value?.ToString() ?? "dark", Theme.Accent);
    }

    private async Task OnAccentChanged(ChangeEventArgs e)
    {
        await Theme.SetAsync(Theme.Mode, e.Value?.ToString() ?? "amber");
    }

    private async Task OnCultureChanged(ChangeEventArgs e)
    {
        await Locale.SetCultureAsync(e.Value?.ToString() ?? "en");
        await BuildNavAsync();
    }

    private async Task LogoutAsync()
    {
        await AuthApi.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    private void OnLocaleChanged() => InvokeAsync(async () => { await BuildNavAsync(); StateHasChanged(); });

    private void OnApiReachabilityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ApiReachability.Changed -= OnApiReachabilityChanged;
        Theme.Changed -= OnThemeChanged;
        Locale.Changed -= OnLocaleChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private sealed record NavItem(string Title, string Href, string Icon, bool Visible, bool Exact);

    private sealed class NavGroup
    {
        public NavGroup(string id, string title, string icon, bool visible, List<NavItem> children, bool leaf = false)
        {
            Id = id;
            Title = title;
            Icon = icon;
            Visible = visible;
            Children = children.Where(c => c.Visible).ToList();
            IsLeaf = leaf;
        }

        public string Id { get; }
        public string Title { get; }
        public string Icon { get; }
        public bool Visible { get; set; }
        public List<NavItem> Children { get; }
        public bool IsLeaf { get; }
    }
}
