<UserControl x:Class="CarAutoParts.Presentation.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:enums="clr-namespace:CarAutoParts.Domain.Enums;assembly=CarAutoParts.Domain"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0" Width="180" Margin="0,0,0,12"
                          ItemsSource="{Binding StatusFilters}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatusFilter}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource PremiumDataGrid}"
                          behaviors:DataGridRowFadeIn.IsEnabled="True"
                          SelectedItem="{Binding SelectedItem}"
                          MinHeight="280"
                          Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding OpenCommand}"
                                      CommandParameter="{Binding SelectedItem}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Transfer #" Binding="{Binding TransferNumber}" Width="140" />
                        <DataGridTextColumn Header="From" Binding="{Binding FromWarehouseName}" Width="*" />
                        <DataGridTextColumn Header="To" Binding="{Binding ToWarehouseName}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding TransferDate, StringFormat=yyyy-MM-dd}" Width="110" />
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8EAF6" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:TransferStatus.Approved}">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:TransferStatus.Completed}">
                                                        <Setter Property="Background" Value="#E8F5E9" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:TransferStatus.Cancelled}">
                                                        <Setter Property="Background" Value="#FFEBEE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusBadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </views:EntityModuleView.MainContent>

        <views:EntityModuleView.EditorContent>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding EditStatus, StringFormat=Status: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />

                    <ComboBox ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding EditFromWarehouse}"
                              materialDesign:HintAssist.Hint="From warehouse"
                              IsEnabled="{Binding IsDraftEditable}"
                              Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding EditToWarehouse}"
                              materialDesign:HintAssist.Hint="To warehouse"
                              IsEnabled="{Binding IsDraftEditable}"
                              Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Notes"
                             Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsDraftEditable}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" />

                    <TextBlock Text="Line items" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,8"
                               Visibility="{Binding IsDraftEditable, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding IsDraftEditable, Converter={StaticResource BoolToVis}}">
                        <TextBox Width="140" Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Search products"
                                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Content="Search" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding SearchProductsCommand}" />
                        <ComboBox Width="160" ItemsSource="{Binding ProductOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProduct}" Margin="0,0,8,0" />
                        <Button Content="Add line" Style="{StaticResource GhostActionButton}"
                                Command="{Binding AddLineCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding EditLines}"
                              Style="{StaticResource PremiumDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              MinHeight="120"
                              MaxHeight="200"
                              Margin="0,0,0,8"
                              IsReadOnly="{Binding EditLinesReadOnly}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" Style="{StaticResource GhostActionButton}"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding CancelEditCommand}" />
                        <Button Content="Create" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Visibility="{Binding CanSaveDraft, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Approve" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding ApproveCommand}"
                                Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Complete" Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding CompleteCommand}"
                                Visibility="{Binding CanComplete, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
