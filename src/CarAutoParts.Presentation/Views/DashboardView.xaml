<UserControl x:Class="CarAutoParts.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CarAutoParts.Presentation.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <controls:LoadingShimmer IsLoading="{Binding IsBusy}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Overview of sales, inventory, and KPIs"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Refresh" Style="{StaticResource GhostActionButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:KpiCard Title="{Binding Title}" Value="{Binding Value}"
                                              Command="{Binding NavigateCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="320" />
                        <ColumnDefinition Width="*" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Sales vs Purchases" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                            <lvc:CartesianChart Series="{Binding SalesSeries}" XAxes="{Binding XAxes}" Height="280" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Category Mix" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                            <lvc:PieChart Series="{Binding CategorySeries}" Height="280" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

