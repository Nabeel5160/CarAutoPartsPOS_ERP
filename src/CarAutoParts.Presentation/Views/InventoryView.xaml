<UserControl x:Class="CarAutoParts.Presentation.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <ComboBox Width="220" Margin="0,0,12,0"
                              ItemsSource="{Binding WarehouseOptions}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedWarehouse}" />
                    <CheckBox Content="Low stock only" VerticalAlignment="Center"
                              IsChecked="{Binding LowStockOnly}" />
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource PremiumDataGrid}"
                          behaviors:DataGridRowFadeIn.IsEnabled="True"
                          SelectedItem="{Binding SelectedItem}"
                          MinHeight="280"
                          Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                        <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="140" />
                        <DataGridTextColumn Header="Qty on hand" Binding="{Binding QuantityOnHand, StringFormat=N0}" Width="110" />
                        <DataGridTextColumn Header="Avg cost" Binding="{Binding AverageCost, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Value" Binding="{Binding StockValue, StringFormat=N2}" Width="100" />
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Adjust" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </views:EntityModuleView.MainContent>
        <views:EntityModuleView.EditorContent>
            <StackPanel>
                <TextBlock Text="Adjust Stock" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding AdjustProductLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding AdjustWarehouseLabel}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Quantity change (+/-)"
                         Text="{Binding EditQuantityDelta, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Reason"
                         Text="{Binding EditReason, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Save" Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
