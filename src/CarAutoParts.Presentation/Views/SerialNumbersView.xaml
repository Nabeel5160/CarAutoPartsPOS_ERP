<UserControl x:Class="CarAutoParts.Presentation.Views.SerialNumbersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource PremiumDataGrid}"
                      behaviors:DataGridRowFadeIn.IsEnabled="True"
                      SelectedItem="{Binding SelectedItem}"
                      MinHeight="320"
                      Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="160" />
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Warehouse" Binding="{Binding CurrentWarehouseName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </views:EntityModuleView.MainContent>
        <views:EntityModuleView.EditorContent>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel>
                    <TextBlock Text="Register Serial Number" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <ComboBox ItemsSource="{Binding Products}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding RegisterProduct}"
                              Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding RegisterWarehouse}"
                              Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource RoundedTextBox}"
                             materialDesign:HintAssist.Hint="Serial number"
                             Text="{Binding RegisterSerial, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding CancelEditCommand}" />
                        <Button Content="Register" Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
