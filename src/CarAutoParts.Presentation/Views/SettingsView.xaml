<UserControl x:Class="CarAutoParts.Presentation.Views.SettingsView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             xmlns:controls="clr-namespace:CarAutoParts.Presentation.Controls">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Margin="0,0,0,16">

            <TextBlock Text="Company Settings" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="Configure company profile and application preferences"

                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />

        </StackPanel>



        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel>

                <controls:LoadingShimmer IsLoading="{Binding IsBusy}" />

                <TextBlock Text="Company" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />

                <TextBox materialDesign:HintAssist.Hint="Company name" Style="{StaticResource RoundedTextBox}"

                         Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox materialDesign:HintAssist.Hint="Address" Style="{StaticResource RoundedTextBox}"

                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox materialDesign:HintAssist.Hint="Phone" Style="{StaticResource RoundedTextBox}"

                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox materialDesign:HintAssist.Hint="Email" Style="{StaticResource RoundedTextBox}"

                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox materialDesign:HintAssist.Hint="NTN / Tax number" Style="{StaticResource RoundedTextBox}"

                         Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" />



                <TextBlock Text="FBR / POS" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,8" />

                <TextBox materialDesign:HintAssist.Hint="STRN" Style="{StaticResource RoundedTextBox}"

                         Text="{Binding Strn, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox materialDesign:HintAssist.Hint="POS ID" Style="{StaticResource RoundedTextBox}"

                         Text="{Binding PosId, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Use FBR sandbox" IsChecked="{Binding FbrUseSandbox}" Margin="0,8" />



                <TextBlock Text="Preferences" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,8" />

                <ComboBox ItemsSource="{Binding ThemeOptions}"

                          SelectedItem="{Binding Theme}"

                          materialDesign:HintAssist.Hint="Theme"

                          Margin="0,0,0,8" />

                <ComboBox ItemsSource="{Binding Warehouses}"

                          DisplayMemberPath="Name"

                          SelectedItem="{Binding DefaultWarehouse}"

                          materialDesign:HintAssist.Hint="Default warehouse"

                          Margin="0,0,0,8" />



                <Button Content="Save Settings" Style="{StaticResource PrimaryActionButton}"

                        Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>

