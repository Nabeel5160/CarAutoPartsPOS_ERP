<UserControl x:Class="CarAutoParts.Presentation.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:CarAutoParts.Presentation.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="20,14" CornerRadius="12" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CashRegister" Width="28" Height="28" Foreground="White" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Point of Sale Terminal" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Integrated with FBR Digital Invoicing" Foreground="#DBEAFE" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#1E40AF" CornerRadius="6" Padding="12,6">
                    <TextBlock Text="{Binding FbrModeLabel}" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="460" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,12,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Products" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                    <TextBox Grid.Row="1" x:Name="BarcodeInputBox"
                             materialDesign:HintAssist.Hint="Scan barcode — press Enter to add"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="BarcodeInput_KeyDown"
                             Margin="0,0,0,8" />
                    <controls:SearchBox Grid.Row="2" SearchText="{Binding SearchText, Mode=TwoWay}"
                                        Placeholder="Search products by name or SKU..." Margin="0,0,0,12" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="172" Height="118" Margin="6"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource GhostActionButton}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SalePrice, Converter={StaticResource Currency}}"
                                                       FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Current Sale" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" item(s)" />
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Buyer name"
                                 Text="{Binding BuyerName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Buyer NTN/CNIC"
                                 Text="{Binding BuyerNtn, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Expander Grid.Row="2" Header="FBR Buyer &amp; Tax Details" Margin="0,0,0,8"
                              IsExpanded="{Binding IsFbrDetailsExpanded}">
                        <StackPanel Margin="0,8,0,0">
                            <ComboBox ItemsSource="{Binding RegistrationTypes}" SelectedItem="{Binding BuyerRegistrationType}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Provinces}" SelectedItem="{Binding BuyerProvince}" IsEditable="True" Margin="0,0,0,8" />
                            <TextBox materialDesign:HintAssist.Hint="Buyer address" Text="{Binding BuyerAddress}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding SandboxScenarios}" Text="{Binding ScenarioId}"
                                      IsEditable="True" Margin="0,0,0,8"
                                      Visibility="{Binding ShowScenarioField, Converter={StaticResource BoolToVis}}" />
                            <ComboBox ItemsSource="{Binding SaleTypes}" SelectedItem="{Binding SaleType}" />
                        </StackPanel>
                    </Expander>

                    <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8,6" Padding="10" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock HorizontalAlignment="Right" Text="{Binding LineTotal, Converter={StaticResource Currency}}" FontWeight="Bold" />
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="−" Width="28" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding Quantity}" Width="40" TextAlignment="Center" VerticalAlignment="Center" />
                                                        <Button Content="+" Width="28" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" Content="Remove" Style="{StaticResource MaterialDesignFlatButton}"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <Grid><TextBlock Text="Subtotal" /><TextBlock HorizontalAlignment="Right" Text="{Binding Subtotal, Converter={StaticResource Currency}}" /></Grid>
                        <Grid><TextBlock Text="Sales Tax" /><TextBlock HorizontalAlignment="Right" Text="{Binding TaxTotal, Converter={StaticResource Currency}}" /></Grid>
                        <Separator Margin="0,8" />
                        <Grid>
                            <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="18" />
                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                                       Text="{Binding GrandTotal, Converter={StaticResource Currency}}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="5" Margin="0,14,0,0">
                        <Button Content="Clear" Style="{StaticResource GhostActionButton}" Command="{Binding ClearCartCommand}" HorizontalAlignment="Left" />
                        <Button Content="Checkout &amp; Send to FBR" Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding CheckoutCommand}"
                                IsEnabled="{Binding CanCheckout}"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <Border Grid.Row="6" Margin="0,14,0,0" CornerRadius="8" Padding="12"
                            Style="{StaticResource GlassCardStyle}"
                            Visibility="{Binding LastFbrInvoiceNumber, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="FBR Invoice Number" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LastFbrInvoiceNumber}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <Image Source="{Binding QrImage}" Width="96" Height="96" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{Binding StatusBarBackground}" Padding="16,8" CornerRadius="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
