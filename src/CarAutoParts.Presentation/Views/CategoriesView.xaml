<UserControl x:Class="CarAutoParts.Presentation.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource PremiumDataGrid}"
                      behaviors:DataGridRowFadeIn.IsEnabled="True"
                      SelectedItem="{Binding SelectedItem}"
                      MinHeight="320"
                      Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Parent" Binding="{Binding ParentName}" Width="160" />
                    <DataGridTextColumn Header="Children" Binding="{Binding ChildCount}" Width="90" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200" />
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                    <Button Content="Delete" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </views:EntityModuleView.MainContent>
        <views:EntityModuleView.EditorContent>
            <StackPanel>
                <TextBlock Text="Category Editor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Name"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Description"
                         Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox ItemsSource="{Binding ParentOptions}" DisplayMemberPath="Name"
                          SelectedValue="{Binding EditParentId}" SelectedValuePath="Id"
                          materialDesign:HintAssist.Hint="Parent category" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Save" Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
