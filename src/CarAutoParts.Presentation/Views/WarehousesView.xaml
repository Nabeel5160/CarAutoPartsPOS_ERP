<UserControl x:Class="CarAutoParts.Presentation.Views.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource PremiumDataGrid}"
                      behaviors:DataGridRowFadeIn.IsEnabled="True"
                      SelectedItem="{Binding SelectedItem}"
                      MinHeight="320"
                      Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120" />
                    <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="140" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="130" />
                    <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="80" />
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                    <Button Content="Delete" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </views:EntityModuleView.MainContent>
        <views:EntityModuleView.EditorContent>
            <StackPanel>
                <TextBlock Text="Warehouse Editor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Name"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Address"
                         Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="City"
                         Text="{Binding EditCity, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Contact Person"
                         Text="{Binding EditContactPerson, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Phone"
                         Text="{Binding EditPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Default warehouse" IsChecked="{Binding EditIsDefault}" Margin="0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Save" Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
