<UserControl x:Class="CarAutoParts.Presentation.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:enums="clr-namespace:CarAutoParts.Domain.Enums;assembly=CarAutoParts.Domain"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0" Width="180" Margin="0,0,0,12"
                          ItemsSource="{Binding StatusFilters}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatusFilter}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource PremiumDataGrid}"
                          behaviors:DataGridRowFadeIn.IsEnabled="True"
                          SelectedItem="{Binding SelectedItem}"
                          MinHeight="280"
                          Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding OpenCommand}"
                                      CommandParameter="{Binding SelectedItem}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PO #" Binding="{Binding OrderNumber}" Width="140" />
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="110" />
                        <DataGridTemplateColumn Header="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8EAF6" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PurchaseOrderStatus.Approved}">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PurchaseOrderStatus.PartiallyReceived}">
                                                        <Setter Property="Background" Value="#FFF3E0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PurchaseOrderStatus.Received}">
                                                        <Setter Property="Background" Value="#E8F5E9" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PurchaseOrderStatus.Cancelled}">
                                                        <Setter Property="Background" Value="#FFEBEE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusBadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="110" />
                        <DataGridTemplateColumn Header="Actions" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </views:EntityModuleView.MainContent>

        <views:EntityModuleView.EditorContent>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding EditStatus, StringFormat=Status: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />

                    <ComboBox ItemsSource="{Binding Suppliers}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding EditSupplier}"
                              materialDesign:HintAssist.Hint="Supplier"
                              IsEnabled="{Binding IsDraftEditable}"
                              Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding EditWarehouse}"
                              materialDesign:HintAssist.Hint="Warehouse"
                              IsEnabled="{Binding IsDraftEditable}"
                              Margin="0,0,0,8" />
                    <DatePicker SelectedDate="{Binding EditExpectedDate}"
                                materialDesign:HintAssist.Hint="Expected date"
                                IsEnabled="{Binding IsDraftEditable}"
                                Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Notes"
                             Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsDraftEditable}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" />

                    <TextBlock Text="Line items" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,8"
                               Visibility="{Binding IsReceiveMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding IsDraftEditable, Converter={StaticResource BoolToVis}}">
                        <TextBox Width="140" Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Search products"
                                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Content="Search" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding SearchProductsCommand}" />
                        <ComboBox Width="160" ItemsSource="{Binding ProductOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProduct}" Margin="0,0,8,0" />
                        <Button Content="Add line" Style="{StaticResource GhostActionButton}"
                                Command="{Binding AddLineCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding EditLines}"
                              Style="{StaticResource PremiumDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              MinHeight="120"
                              MaxHeight="200"
                              Margin="0,0,0,8"
                              IsReadOnly="{Binding EditLinesReadOnly}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ordered" Binding="{Binding QuantityOrdered, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="Rcvd" Binding="{Binding QuantityReceived}" Width="50" IsReadOnly="True" />
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" Style="{StaticResource GhostActionButton}"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ItemsControl ItemsSource="{Binding EditLines}"
                                  Visibility="{Binding IsReceiveMode, Converter={StaticResource BoolToVis}}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}"
                                             materialDesign:HintAssist.Hint="Qty"
                                             Text="{Binding ReceiveQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding EditGrandTotal, StringFormat=Total: {0:N2}}"
                               FontWeight="SemiBold" Margin="0,0,0,12"
                               Visibility="{Binding EditOrderNumber, Converter={StaticResource NullToVis}}" />

                    <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Receive notes"
                             Text="{Binding ReceiveNotes, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsReceiveMode, Converter={StaticResource BoolToVis}}"
                             Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding CancelEditCommand}" />
                        <Button Content="Save draft" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Visibility="{Binding CanSaveDraft, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Approve" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding ApproveCommand}"
                                Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Receive" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding StartReceiveCommand}"
                                Visibility="{Binding CanReceive, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Confirm receive" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"
                                Command="{Binding ConfirmReceiveCommand}"
                                Visibility="{Binding IsReceiveMode, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Back" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding CancelReceiveCommand}"
                                Visibility="{Binding IsReceiveMode, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Cancel PO" Style="{StaticResource GhostActionButton}"
                                Command="{Binding CancelOrderCommand}"
                                Visibility="{Binding CanCancelOrder, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
