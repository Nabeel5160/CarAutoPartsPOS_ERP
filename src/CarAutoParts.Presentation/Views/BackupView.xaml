<UserControl x:Class="CarAutoParts.Presentation.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="Restore from file..." Style="{StaticResource GhostActionButton}"
                        HorizontalAlignment="Left" Margin="0,0,0,12"
                        Command="{Binding RestoreFromFileCommand}"
                        Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource PremiumDataGrid}"
                          behaviors:DataGridRowFadeIn.IsEnabled="True"
                          SelectedItem="{Binding SelectedItem}"
                          MinHeight="280"
                          IsReadOnly="True"
                          Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding BackupDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                        <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding BackupType}" Width="100" />
                        <DataGridTextColumn Header="Size (bytes)" Binding="{Binding FileSizeBytes}" Width="110" />
                        <DataGridCheckBoxColumn Header="OK" Binding="{Binding IsSuccessful}" Width="50" />
                        <DataGridTemplateColumn Header="Actions" Width="100"
                                                Visibility="{Binding DataContext.CanRestore, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Restore" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </views:EntityModuleView.MainContent>
    </views:EntityModuleView>
</UserControl>
