<UserControl x:Class="CarAutoParts.Presentation.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource PremiumDataGrid}"
                      behaviors:DataGridRowFadeIn.IsEnabled="True"
                      SelectedItem="{Binding SelectedItem}"
                      MinHeight="320"
                      Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140" />
                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                    <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                    <DataGridTemplateColumn Header="Actions" Width="160"
                                            Visibility="{Binding DataContext.CanManageUsers, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Margin="0,0,4,0" />
                                    <Button Content="Delete" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </views:EntityModuleView.MainContent>
        <views:EntityModuleView.EditorContent>
            <StackPanel>
                <TextBlock Text="User Editor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Username"
                         Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Password (leave blank to keep)"
                         Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Display name"
                         Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Email"
                         Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Active" IsChecked="{Binding EditIsActive}" Margin="0,8" />
                <TextBlock Text="Roles" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,8" />
                <ItemsControl ItemsSource="{Binding RoleOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Save" Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
