<Window x:Class="CarAutoParts.Presentation.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Car Auto Parts ERP"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.FontSize="14">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSidebarVisible, Converter={StaticResource SidebarWidth}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel Width="280">
                    <Border DockPanel.Dock="Top" Padding="20,20,16,20" Background="{StaticResource HeaderGradientBrush}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Car Auto Parts" Foreground="White" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Enterprise ERP" Foreground="#DBEAFE" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding ToggleSidebarPinCommand}"
                                        ToolTip="{Binding SidebarPinToolTip}"
                                        Foreground="White" Margin="0,0,4,0">
                                    <materialDesign:PackIcon>
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Pin" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarPinned}" Value="True">
                                                        <Setter Property="Kind" Value="PinOff" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding ToggleSidebarCommand}"
                                        ToolTip="Hide menu"
                                        Foreground="White"
                                        Visibility="{Binding IsSidebarPinned, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <materialDesign:PackIcon Kind="ChevronLeft" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,16">
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="10,2" CornerRadius="10">
                                        <Button Style="{StaticResource NavMenuButtonStyle}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="{Binding Icon, Converter={StaticResource PackIconKind}}"
                                                                         Width="20" Height="20"
                                                                         VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="Show / hide menu">
                                <materialDesign:PackIcon Kind="Menu" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding ToggleSidebarPinCommand}"
                                    ToolTip="{Binding SidebarPinToolTip}"
                                    Margin="4,0,0,0">
                                <materialDesign:PackIcon>
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="PinOutline" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarPinned}" Value="True">
                                                    <Setter Property="Kind" Value="Pin" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentPageTitle}" FontWeight="SemiBold" FontSize="18" />
                                <TextBlock Text="Car Auto Parts ERP" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid HorizontalAlignment="Right">
                                <controls:SearchBox xmlns:controls="clr-namespace:CarAutoParts.Presentation.Controls"
                                                    x:Name="GlobalSearchBox"
                                                    Width="260" Placeholder="Global search..."
                                                    SearchText="{Binding GlobalSearchText, Mode=TwoWay}"
                                                    SearchCommand="{Binding GlobalSearchCommand}"
                                                    Margin="0,0,8,0" />
                                <Popup IsOpen="{Binding IsSearchResultsOpen}"
                                       PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                            MinWidth="320"
                                            MaxWidth="420"
                                            MaxHeight="280">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Search results"
                                                       FontWeight="SemiBold" Margin="8,4,8,8"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ListBox ItemsSource="{Binding SearchResults}"
                                                     BorderThickness="0"
                                                     Background="Transparent">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource NavMenuButtonStyle}"
                                                                Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Subtitle}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding OpenNotificationsCommand}"
                                    ToolTip="View notifications">
                                <materialDesign:Badged Badge="{Binding UnreadNotifications}">
                                    <materialDesign:PackIcon Kind="Bell" />
                                </materialDesign:Badged>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="{Binding ThemeToggleToolTip}" Margin="4,0">
                                <materialDesign:PackIcon>
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="WeatherNight" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Kind" Value="WhiteBalanceSunny" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" Margin="4,0">
                                <materialDesign:PackIcon Kind="AccountCircle" />
                            </Button>
                            <TextBlock Text="{Binding UserDisplayName}" VerticalAlignment="Center" Margin="8,0,12,0" />
                            <Button Content="Logout" Style="{StaticResource GhostActionButton}"
                                    Command="{Binding LogoutCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="20,16,20,16" ClipToBounds="True">
                    <ContentControl Content="{Binding CurrentView}"
                                    ContentTemplateSelector="{StaticResource ViewModelTemplateSelector}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Border>

                <materialDesign:Snackbar x:Name="MainSnackbar" Grid.Row="2" />
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
