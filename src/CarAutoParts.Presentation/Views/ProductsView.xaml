<UserControl x:Class="CarAutoParts.Presentation.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CarAutoParts.Presentation.Controls"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Products" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Manage catalog, pricing, and stock"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <controls:SearchBox Width="280" Margin="24,0,0,0"
                                    SearchText="{Binding SearchText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="New" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"
                        Command="{Binding NewProductCommand}" />
                <Button Content="Refresh" Style="{StaticResource GhostActionButton}"
                        Command="{Binding LoadProductsCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="12">
            <Grid>
                <controls:LoadingShimmer IsLoading="{Binding IsBusy}" />
                <DataGrid ItemsSource="{Binding Products}"
                          Style="{StaticResource PremiumDataGrid}"
                          behaviors:DataGridRowFadeIn.IsEnabled="True"
                          SelectedItem="{Binding SelectedProduct}"
                          VerticalAlignment="Stretch"
                          MinHeight="320"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140" />
                        <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="120" />
                        <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding TotalStock, StringFormat=N0}" Width="80" />
                        <DataGridTemplateColumn Header="Actions" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Style="{StaticResource GhostActionButton}"
                                                Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Margin="0,0,4,0" />
                                        <Button Content="Delete" Style="{StaticResource GhostActionButton}"
                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Previous" Style="{StaticResource GhostActionButton}" Command="{Binding PreviousPageCommand}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0"
                       Text="{Binding CurrentPage, StringFormat=Page {0}}" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="{Binding TotalPages, StringFormat=of {0}}" />
            <Button Content="Next" Style="{StaticResource GhostActionButton}" Command="{Binding NextPageCommand}" />
        </StackPanel>

        <Border Grid.RowSpan="3" Style="{StaticResource GlassPanelStyle}"
                Width="420" HorizontalAlignment="Right"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Product Editor" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Name"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="SKU"
                         Text="{Binding EditSku, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Barcode"
                         Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                          SelectedValue="{Binding EditCategoryId}" SelectedValuePath="Id" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="Name"
                          SelectedValue="{Binding EditBrandId}" SelectedValuePath="Id" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Sale Price"
                         Text="{Binding EditSalePrice, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Purchase Price"
                         Text="{Binding EditPurchasePrice, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Active" IsChecked="{Binding EditIsActive}" Margin="0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Save" Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding SaveProductCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
