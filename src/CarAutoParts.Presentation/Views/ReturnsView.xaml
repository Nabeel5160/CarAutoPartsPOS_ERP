<UserControl x:Class="CarAutoParts.Presentation.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:CarAutoParts.Domain.Enums;assembly=CarAutoParts.Domain">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource PremiumDataGrid}"
                      behaviors:DataGridRowFadeIn.IsEnabled="True"
                      SelectedItem="{Binding SelectedItem}"
                      IsReadOnly="True"
                      MinHeight="280"
                      Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Return #" Binding="{Binding ReturnNumber}" Width="140" />
                    <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="120" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, StringFormat=yyyy-MM-dd}" Width="110" />
                    <DataGridTextColumn Header="Type" Binding="{Binding ReturnType}" Width="90" />
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </views:EntityModuleView.MainContent>

        <views:EntityModuleView.EditorContent>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

                    <ComboBox ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding EditWarehouse}"
                              materialDesign:HintAssist.Hint="Warehouse"
                              Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding ReturnTypes}"
                              SelectedItem="{Binding EditReturnType}"
                              materialDesign:HintAssist.Hint="Return type"
                              Margin="0,0,0,8" />

                    <TextBlock Text="Link to invoice (optional)" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="140" Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Search invoice"
                                 Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Content="Search" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding SearchInvoicesCommand}" />
                        <ComboBox Width="180" ItemsSource="{Binding InvoiceOptions}"
                                  DisplayMemberPath="InvoiceNumber"
                                  SelectedItem="{Binding EditInvoice}" />
                    </StackPanel>
                    <Button Content="Load lines from invoice" Style="{StaticResource GhostActionButton}" HorizontalAlignment="Left"
                            Command="{Binding LoadInvoiceLinesCommand}" Margin="0,0,0,12" />

                    <TextBlock Text="Return lines" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="140" Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Search products"
                                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Content="Search" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding SearchProductsCommand}" />
                        <ComboBox Width="160" ItemsSource="{Binding ProductOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProduct}" Margin="0,0,8,0" />
                        <Button Content="Add line" Style="{StaticResource GhostActionButton}"
                                Command="{Binding AddLineCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding EditLines}"
                              Style="{StaticResource PremiumDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              MinHeight="100"
                              MaxHeight="180"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" Style="{StaticResource GhostActionButton}"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox Style="{StaticResource RoundedTextBox}" materialDesign:HintAssist.Hint="Notes"
                             Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource GhostActionButton}" Margin="0,0,8,0"
                                Command="{Binding CancelEditCommand}" />
                        <Button Content="Create return" Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </views:EntityModuleView.EditorContent>
    </views:EntityModuleView>
</UserControl>
