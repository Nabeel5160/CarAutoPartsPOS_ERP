<UserControl x:Class="CarAutoParts.Presentation.Views.EntityModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CarAutoParts.Presentation.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <controls:SearchBox Width="280" Margin="24,0,0,0"
                                    SearchText="{Binding SearchText, Mode=TwoWay}"
                                    SearchCommand="{Binding SearchCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="{Binding PrimaryActionText}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"
                        Command="{Binding NewCommand}"
                        Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVis}}" />
                <Button Content="Refresh" Style="{StaticResource GhostActionButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="12">
            <Grid>
                <controls:LoadingShimmer IsLoading="{Binding IsBusy}" />
                <ContentPresenter Content="{Binding MainContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}}">
                    <materialDesign:PackIcon Kind="DatabaseOff" Style="{StaticResource EmptyStateIconStyle}" />
                    <TextBlock Text="{Binding PlaceholderMessage}" Style="{StaticResource EmptyStateTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                    Visibility="{Binding ShowPaging, Converter={StaticResource BoolToVis}}">
            <Button Content="Previous" Style="{StaticResource GhostActionButton}" Command="{Binding PreviousPageCommand}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0"
                       Text="{Binding CurrentPage, StringFormat=Page {0}}" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="{Binding TotalPages, StringFormat=of {0}}" />
            <Button Content="Next" Style="{StaticResource GhostActionButton}" Command="{Binding NextPageCommand}" />
        </StackPanel>

        <Border Grid.RowSpan="3" Style="{StaticResource GlassPanelStyle}"
                Width="420" HorizontalAlignment="Right"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <ContentPresenter Content="{Binding EditorContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>
    </Grid>
</UserControl>
