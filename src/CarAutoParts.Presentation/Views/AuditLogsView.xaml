<UserControl x:Class="CarAutoParts.Presentation.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <DatePicker Width="160" Margin="0,0,12,0"
                                materialDesign:HintAssist.Hint="From"
                                SelectedDate="{Binding FilterFromDate}" />
                    <DatePicker Width="160" Margin="0,0,12,0"
                                materialDesign:HintAssist.Hint="To"
                                SelectedDate="{Binding FilterToDate}" />
                    <TextBox Width="160" Margin="0,0,12,0" Style="{StaticResource RoundedTextBox}"
                             materialDesign:HintAssist.Hint="User name"
                             Text="{Binding FilterUserName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Apply" Style="{StaticResource GhostActionButton}"
                            Command="{Binding ApplyFiltersCommand}" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource PremiumDataGrid}"
                          behaviors:DataGridRowFadeIn.IsEnabled="True"
                          MinHeight="280"
                          IsReadOnly="True"
                          Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100" />
                        <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120" />
                        <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="80" />
                        <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </views:EntityModuleView.MainContent>
    </views:EntityModuleView>
</UserControl>
