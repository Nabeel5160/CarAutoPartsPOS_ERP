<UserControl x:Class="CarAutoParts.Presentation.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarAutoParts.Presentation.Views"
             xmlns:behaviors="clr-namespace:CarAutoParts.Presentation.Behaviors"
             xmlns:enums="clr-namespace:CarAutoParts.Domain.Enums;assembly=CarAutoParts.Domain">
    <views:EntityModuleView>
        <views:EntityModuleView.MainContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0" Width="180" Margin="0,0,0,12"
                          ItemsSource="{Binding StatusFilters}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatusFilter}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource PremiumDataGrid}"
                          behaviors:DataGridRowFadeIn.IsEnabled="True"
                          IsReadOnly="True"
                          MinHeight="280"
                          Visibility="{Binding PlaceholderMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="140" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="110" />
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" Background="#E8EAF6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8EAF6" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:SalesOrderStatus.Confirmed}">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:SalesOrderStatus.Invoiced}">
                                                        <Setter Property="Background" Value="#E8F5E9" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:SalesOrderStatus.Cancelled}">
                                                        <Setter Property="Background" Value="#FFEBEE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusBadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </views:EntityModuleView.MainContent>
    </views:EntityModuleView>
</UserControl>
